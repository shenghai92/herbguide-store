---
import "../styles/global.css";
import { footerNav, siteConfig, topNav } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  path?: string;
  robots?: string;
  type?: "website" | "article";
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = new URL(siteConfig.socialImage, siteConfig.url).toString(),
  path = Astro.url.pathname,
  robots = "index, follow",
  type = "website",
  structuredData,
} = Astro.props;

const canonical = new URL(path, siteConfig.url).toString();
const googleToken = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingToken = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || siteConfig.gaMeasurementId;
const schemaGraph = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.name,
    url: siteConfig.url,
    description: siteConfig.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteConfig.name,
    url: siteConfig.url,
    email: siteConfig.supportEmail,
  },
  ...(structuredData
    ? Array.isArray(structuredData)
      ? structuredData
      : [structuredData]
    : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={siteConfig.tagline} />
    <meta property="og:locale" content="en_US" />
    <meta name="author" content={siteConfig.name} />
    <meta name="theme-color" content="#f4efe4" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteConfig.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {googleToken && <meta name="google-site-verification" content={googleToken} />}
    {bingToken && <meta name="msvalidate.01" content={bingToken} />}
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script
          is:inline
          set:html={`
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '${gaMeasurementId}');
          `}
        />
      </>
    )}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsenseClient}`}
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">
          <span class="brand-mark">HG</span>
          <span>
            <strong>{siteConfig.name}</strong>
            <small>{siteConfig.domain}</small>
          </span>
        </a>
        <nav class="main-nav" aria-label="Primary">
          {topNav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <h2>{siteConfig.name}</h2>
          <p>
            Traditional herbs and kitchen traditions, explained simply for curious readers who want
            clarity without hype.
          </p>
          <p>
            Support: <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>
          </p>
          <p class="footer-note">
            Educational content only. HerbGuide shares general learning materials, not personal
            care instructions.
          </p>
        </div>
        <div>
          <h3>Main Pages</h3>
          <ul>
            {topNav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>All Site Links</h3>
          <ul>
            {footerNav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Contact & Review</h3>
          <ul>
            <li><a href={`mailto:${siteConfig.supportEmail}`}>Email Support</a></li>
            <li><a href="/about/">About HerbGuide</a></li>
            <li><a href="/editorial-policy/">Editorial Policy</a></li>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
          </ul>
        </div>
      </div>
      <div class="shell footer-bottom">
        <p>&copy; 2026 {siteConfig.name}. All rights reserved.</p>
        <p>{siteConfig.domain}</p>
      </div>
    </footer>
  </body>
</html>
