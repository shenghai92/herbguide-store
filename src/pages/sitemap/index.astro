---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { basicsArticles, classicsArticles, foodTherapyArticles } from "../../data/articles";
import { herbs } from "../../data/herbs";
import { topics } from "../../data/topics";
---

<BaseLayout
  title="HTML Sitemap | HerbGuide"
  description="A complete HTML sitemap for HerbGuide, including herb profiles, basics, kitchen articles, and site policy pages."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "HTML Sitemap",
      description:
        "A complete HTML sitemap for HerbGuide, including herb profiles, basics, kitchen articles, and site policy pages.",
      url: "https://herbguide.store/sitemap/",
    },
  ]}
>
  <section class="page-hero">
    <div class="shell narrow prose-block">
      <p class="eyebrow">HTML Sitemap</p>
      <h1>Browse every section of HerbGuide</h1>
      <p>
        This page helps readers and search engines discover the full site structure in one
        place, including herb profiles, basics, Chinese classics, and kitchen-focused
        articles.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Main sections</p>
        <h2>Core pages</h2>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/herbs/">Herb Library</a></li>
          <li><a href="/topics/">Topics</a></li>
          <li><a href="/glossary/">Glossary</a></li>
          <li><a href="/kitchen/">Kitchen Traditions</a></li>
          <li><a href="/basics/">Basics</a></li>
          <li><a href="/classics/">Chinese Classics</a></li>
          <li><a href="/safety/">Safety</a></li>
          <li><a href="/about/">About</a></li>
        </ul>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Trust pages</p>
        <h2>Policy and reference pages</h2>
        <ul>
          <li><a href="/disclaimer/">Disclaimer</a></li>
          <li><a href="/editorial-policy/">Editorial Policy</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/robots.txt">robots.txt</a></li>
          <li><a href="/sitemap-index.xml">XML Sitemap</a></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <article class="prose-block card">
        <p class="eyebrow">Herb Library</p>
        <h2>All herb profiles</h2>
        <div class="launch-list">
          {herbs.map((herb) => (
            <a href={`/herbs/${herb.slug}/`}>{herb.name}</a>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Topics</p>
        <h2>Topic hubs</h2>
        <ul>
          {topics.map((topic) => (
            <li><a href={`/topics/${topic.slug}/`}>{topic.title}</a></li>
          ))}
        </ul>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Basics</p>
        <h2>Plain-English concept pages</h2>
        <ul>
          {basicsArticles.map((article) => (
            <li><a href={`/basics/${article.slug}/`}>{article.title}</a></li>
          ))}
        </ul>
      </article>

    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Kitchen Traditions</p>
        <h2>Kitchen and recipe-style articles</h2>
        <ul>
          {foodTherapyArticles.map((article) => (
            <li><a href={`/kitchen/${article.slug}/`}>{article.title}</a></li>
          ))}
        </ul>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Glossary</p>
        <h2>Direct question entry page</h2>
        <ul>
          <li><a href="/glossary/">Glossary</a></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <article class="prose-block card">
        <p class="eyebrow">Chinese Classics</p>
        <h2>Classical context pages</h2>
        <ul>
          {classicsArticles.map((article) => (
            <li><a href={`/classics/${article.slug}/`}>{article.title}</a></li>
          ))}
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
