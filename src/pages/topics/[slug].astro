---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { topics } from "../../data/topics";

export function getStaticPaths() {
  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const topicSeoMap: Record<
  string,
  {
    title: string;
    description: string;
    extraKeywords: string[];
    heroNote?: string;
  }
> = {
  "seasonal-kitchen-ideas": {
    title: "Seasonal Kitchen Ideas Guide | Warming Foods, Cooling Teas, and Soup Pages",
    description:
      "A seasonal kitchen ideas guide covering warming foods, cooling teas, pear soups, and practical herb pages in one clear theme.",
    extraKeywords: ["seasonal kitchen ideas", "warming foods", "cooling foods", "seasonal tea ideas", "seasonal soup ideas"],
    heroNote:
      "Readers often reach this page when they want seasonal kitchen ideas before they know a herb name, so the guide keeps warming foods, cooling teas, and soup-style routes easy to scan.",
  },
};
const topicSeo = topicSeoMap[topic.slug];
const topicKeywords = [
  topic.title,
  `${topic.title} guide`,
  `${topic.title} herbs`,
  `${topic.title} tea`,
  `${topic.title} recipes`,
  "ingredient guide",
  "kitchen ideas",
  "plain English",
  ...(topicSeo?.extraKeywords ?? []),
];
const topicFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: `What is covered in ${topic.title}?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `${topic.title} groups related herb guides, kitchen pages, and basics articles so readers can browse one theme in a clearer way.`,
      },
    },
    {
      "@type": "Question",
      name: `Can ${topic.title} help if I do not know a herb name yet?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `Yes. Topic pages are designed for readers who start with a theme such as tea, soup, pantry habits, warming foods, or digestive traditions rather than a specific herb name.`,
      },
    },
  ],
};
---

<BaseLayout
  title={topicSeo?.title ?? `${topic.title} Guide | HerbGuide`}
  description={topicSeo?.description ?? `${topic.description} Browse related herbs, kitchen pages, and basics articles in one theme.`}
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: topic.title,
      description: topic.description,
      url: `https://herbguide.store/topics/${topic.slug}/`,
      keywords: topicKeywords.join(", "),
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://herbguide.store/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Topics",
          item: "https://herbguide.store/topics/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: topic.title,
          item: `https://herbguide.store/topics/${topic.slug}/`,
        },
      ],
    },
    topicFaqSchema,
  ]}
>
  <section class="page-hero">
    <div class="shell narrow prose-block">
      <p class="eyebrow">{topic.eyebrow}</p>
      <h1>{topic.title}</h1>
      <p>{topic.intro}</p>
      {topicSeo?.heroNote && <p>{topicSeo.heroNote}</p>}
      <p>
        This guide helps readers browse one theme through herb guides, kitchen recipes,
        and basics explainers instead of trying to piece the topic together page by page.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell narrow stack">
      {topic.sections.map((section) => (
        <article class="prose-block card">
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
        </article>
      ))}

      <article class="prose-block card">
        <p class="eyebrow">Related reading</p>
        <h2>Continue with pages in the same theme</h2>
        <div class="stack">
          {topic.featuredLinks.map((link) => (
            <article class="list-card">
              <h3><a href={link.href}>{link.title}</a></h3>
              <p>{link.text}</p>
              <p class="card-link"><a href={link.href}>Open page</a></p>
            </article>
          ))}
        </div>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Keep exploring</p>
        <h2>Browse more topic pages</h2>
        <p>
          Return to <a href="/topics/">Topics</a> for more guided routes through herbs, basics,
          and kitchen content.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Topic FAQ</p>
        <h2>Common reader questions</h2>
        <h3>What is covered in {topic.title}?</h3>
        <p>
          {topic.title} groups related herb guides, kitchen pages, and basics articles so
          readers can browse one theme in a clearer way.
        </p>
        <h3>Can this page help if I do not know a herb name yet?</h3>
        <p>
          Yes. Topic pages are made for readers who start with a theme such as tea, soup,
          pantry habits, warming foods, or digestive traditions rather than a specific herb name.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
