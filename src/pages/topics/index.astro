---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import { topics } from "../../data/topics";
---

<BaseLayout
  title="Chinese Herb Topics and TCM Guides | HerbGuide"
  description="Browse Chinese herb topics, pantry ingredient groups, and food therapy guides for beginner-friendly exploration."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "Topics",
      description:
        "Curated topic pages that connect Chinese herbs, TCM basics, and food therapy into clear beginner-friendly guides.",
      url: "https://herbguide.store/topics/",
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What are HerbGuide topic pages for?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "HerbGuide topic pages group related herbs, food therapy pages, and TCM basics so readers can browse by theme instead of isolated pages.",
          },
        },
        {
          "@type": "Question",
          name: "Which topic pages are best for beginners?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Balanced Pantry Habits, Seasonal Kitchen Ideas, Warming Foods, and Evening Teas are among the easiest starting points for beginner readers.",
          },
        },
      ],
    },
  ]}
>
  <section class="page-hero">
    <div class="shell narrow">
      <p class="eyebrow">Topics</p>
      <h1>Browse HerbGuide by theme</h1>
      <p>
        These topic pages connect herb pages, food therapy articles, and TCM basics so
        beginners do not have to guess what to read next.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro
        eyebrow="Curated guides"
        title="Start with a familiar theme"
        text="Each topic page groups related articles together, making the library feel more practical and easier to browse."
      />
      <div class="card-grid">
        {topics.map((topic) => (
          <article class="card">
            <p class="eyebrow">{topic.eyebrow}</p>
            <h2><a href={`/topics/${topic.slug}/`}>{topic.title}</a></h2>
            <p>{topic.description}</p>
            <p class="card-link"><a href={`/topics/${topic.slug}/`}>Open topic page</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">By theme</p>
        <h2>Browse Chinese herbs by topic, not just by ingredient</h2>
        <p>
          Many readers do not start with a single herb name. They start with broader questions
          like which Chinese ingredients feel warming, which pantry herbs fit quiet evening tea,
          or which pages explain dampness through food.
        </p>
        <p>
          That is why these topic pages matter. They help readers move through broader themes
          in a way that feels more useful than a flat archive.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Best clusters</p>
        <h2>Useful topic clusters to start with</h2>
        <ul>
          <li>Warming foods, ginger pages, and cold-weather soups</li>
          <li>Cooling teas, chrysanthemum, mint, and seasonal kitchen reading</li>
          <li>Pantry berries, breakfast bowls, and gentle food therapy basics</li>
          <li>Digestive traditions, chen pi, hawthorn, and simple grain-style pages</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Why topics help</p>
        <h2>From scattered pages to clearer groups</h2>
        <p>
          Topic pages make the library easier to understand. Instead of treating every article
          as isolated, HerbGuide can connect pantry herbs, comparison pages, and recipe-style
          articles into more coherent clusters.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Best starting points</p>
        <h2>Strong starting points right now</h2>
        <ul>
          <li><a href="/topics/warming-foods/">Warming Foods</a></li>
          <li><a href="/topics/seasonal-kitchen-ideas/">Seasonal Kitchen Ideas</a></li>
          <li><a href="/topics/balanced-pantry-habits/">Balanced Pantry Habits</a></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">If readers arrived for recipes</p>
        <h2>Best kitchen-first topic pages</h2>
        <ul>
          <li><a href="/topics/evening-teas/">Evening Teas</a></li>
          <li><a href="/topics/digestive-traditions/">Digestive Traditions</a></li>
          <li><a href="/topics/beauty-foods/">Beauty Foods</a></li>
        </ul>
        <p>
          The best kitchen-first pairings right now are
          <a href="/topics/digestive-traditions/"> Digestive Traditions</a> with
          <a href="/food-therapy/jobs-tears-porridge-for-heavy-days/"> Job's Tears Porridge</a>
          and <a href="/topics/evening-teas/">Evening Teas</a> with
          <a href="/food-therapy/pear-and-chrysanthemum-tea-for-warm-afternoons/"> Pear and Chrysanthemum Tea</a>.
        </p>
        <p>
          For comparison-first readers, pair <a href="/topics/evening-teas/">Evening Teas</a>
          with <a href="/basics/chrysanthemum-vs-mint/">Chrysanthemum vs Mint</a>.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">If readers arrived for definitions</p>
        <h2>Use topic pages with the glossary</h2>
        <p>
          Topic pages work especially well after one short glossary read. If a reader first
          learns a phrase like qi, dampness, tonify, or clear heat, a topic page gives them a
          practical follow-up instead of leaving the term abstract.
        </p>
        <p>
          The best partner page for this is the <a href="/glossary/">TCM Glossary</a>.
        </p>
        <p>
          For pantry-style readers, a strong alternate path is
          <a href="/basics/goji-berry-tea-vs-goji-berry-porridge/"> Goji Berry Tea vs Goji Berry Porridge</a>
          to <a href="/topics/balanced-pantry-habits/">Balanced Pantry Habits</a>.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
