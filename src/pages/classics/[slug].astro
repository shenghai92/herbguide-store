---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { classicsArticles } from "../../data/articles";

export function getStaticPaths() {
  return classicsArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
---

<BaseLayout
  title={`${article.title} | HerbGuide`}
  description={article.description}
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: article.title,
      description: article.description,
      url: `https://herbguide.store/classics/${article.slug}/`,
      author: {
        "@type": "Organization",
        name: "HerbGuide",
      },
      publisher: {
        "@type": "Organization",
        name: "HerbGuide",
      },
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://herbguide.store/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Chinese Classics",
          item: "https://herbguide.store/classics/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: article.title,
          item: `https://herbguide.store/classics/${article.slug}/`,
        },
      ],
    },
  ]}
>
  <section class="page-hero">
    <div class="shell narrow prose-block">
      <p class="eyebrow">{article.eyebrow}</p>
      <h1>{article.title}</h1>
      <p>{article.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="shell narrow stack">
      {article.sections.map((section) => (
        <article class="prose-block card">
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
        </article>
      ))}
      <article class="prose-block card">
        <p class="eyebrow">Read this with</p>
        <h2>Useful next pages for context</h2>
        <p>
          Classical reading becomes much easier when paired with the plain-English material in
          <a href="/basics/"> Basics</a> and a few concrete herb examples.
        </p>
        <ul>
          <li><a href="/basics/what-is-tcm/">What Is This Traditional Framework?</a></li>
          <li><a href="/herbs/goji-berry/">Goji Berry</a></li>
          <li><a href="/herbs/chen-pi/">Chen Pi</a></li>
          <li><a href="/herbs/astragalus-root/">Astragalus Root</a></li>
        </ul>
      </article>
      <article class="prose-block card">
        <p class="eyebrow">Keep exploring</p>
        <h2>Back to Chinese Classics</h2>
        <p>
          This article is part of the <a href="/classics/">Chinese Classics</a> section. Go back
          there to continue through the core texts behind traditional herb language.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
