---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import { recipeCards } from "../../data/content";

const recipeSearchThemes: Record<string, string[]> = {
  "5-easy-traditional-kitchen-ingredients-for-beginners": ["beginner", "pantry", "gentle", "daily kitchen"],
  "a-simple-warming-soup-guide-for-cold-weather": ["warming", "comfort", "cold weather", "gentle soup"],
  "jujube-and-ginger-tea-for-busy-weeks": ["warming", "routine", "gentle", "tea"],
  "pear-and-lily-bulb-soup-for-dry-days": ["moistening", "gentle", "dry days", "soft soup"],
  "black-sesame-breakfast-ideas-for-beginners": ["nourishing", "breakfast", "gentle", "pantry"],
  "chrysanthemum-and-mint-cooling-tea-basics": ["cooling", "tea", "light", "seasonal"],
  "goji-berry-porridge-for-gentle-mornings": ["nourishing", "breakfast", "porridge", "gentle"],
  "lotus-seed-and-longan-sweet-soup-basics": ["nourishing", "dessert soup", "calm", "gentle"],
  "chen-pi-tea-for-heavy-meal-days": ["digestive", "tea", "aromatic", "post-meal"],
  "hawthorn-berry-tea-for-rich-meals": ["digestive", "tea", "rich meals", "tart"],
  "black-sesame-and-jujube-breakfast-bowl": ["nourishing", "breakfast", "warm", "pantry"],
  "jobs-tears-porridge-for-heavy-days": ["light", "digestive", "grain", "everyday"],
  "pear-and-chrysanthemum-tea-for-warm-afternoons": ["cooling", "tea", "dryness", "light"],
  "mulberry-and-goji-tea-basics": ["nourishing", "tea", "berry", "gentle"],
  "goji-and-chrysanthemum-tea-basics": ["balanced", "tea", "cooling", "nourishing"],
  "jujube-and-lotus-seed-congee-for-quiet-evenings": ["calm", "congee", "nourishing", "gentle"],
  "tremella-and-pear-sweet-soup-basics": ["moistening", "dessert soup", "gentle", "soft"],
  "adzuki-bean-and-jobs-tears-soup-basics": ["light", "digestive", "soup", "pantry"],
  "chinese-yam-and-carrot-soup-basics": ["gentle", "daily soup", "balanced", "comfort"],
  "perilla-and-ginger-soup-for-cool-days": ["warming", "soup", "seasonal", "aromatic"],
  "tremella-and-lotus-seed-sweet-soup-basics": ["moistening", "dessert soup", "soft", "nourishing"],
  "schisandra-and-jujube-tea-basics": ["calm", "tea", "gentle", "evening"],
  "monk-fruit-and-pear-tea-basics": ["cooling", "tea", "pear", "light"],
  "walnut-and-black-sesame-paste-basics": ["nourishing", "breakfast", "pantry", "warm bowl"],
  "barley-sprout-and-chen-pi-tea-basics": ["digestive", "tea", "post-meal", "pantry"],
  "chinese-yam-and-jujube-porridge-basics": ["balanced", "porridge", "gentle", "breakfast"],
};

const recipeCategoryMap: Record<string, string> = {
  "5-easy-traditional-kitchen-ingredients-for-beginners": "Pantry Basics",
  "a-simple-warming-soup-guide-for-cold-weather": "Warming",
  "jujube-and-ginger-tea-for-busy-weeks": "Warming",
  "pear-and-lily-bulb-soup-for-dry-days": "Moistening",
  "black-sesame-breakfast-ideas-for-beginners": "Nourishing",
  "chrysanthemum-and-mint-cooling-tea-basics": "Cooling",
  "goji-berry-porridge-for-gentle-mornings": "Nourishing",
  "lotus-seed-and-longan-sweet-soup-basics": "Calming",
  "chen-pi-tea-for-heavy-meal-days": "Digestive",
  "hawthorn-berry-tea-for-rich-meals": "Digestive",
  "black-sesame-and-jujube-breakfast-bowl": "Nourishing",
  "jobs-tears-porridge-for-heavy-days": "Digestive",
  "pear-and-chrysanthemum-tea-for-warm-afternoons": "Cooling",
  "mulberry-and-goji-tea-basics": "Nourishing",
  "goji-and-chrysanthemum-tea-basics": "Balanced",
  "jujube-and-lotus-seed-congee-for-quiet-evenings": "Calming",
  "tremella-and-pear-sweet-soup-basics": "Moistening",
  "adzuki-bean-and-jobs-tears-soup-basics": "Digestive",
  "chinese-yam-and-carrot-soup-basics": "Balanced",
  "perilla-and-ginger-soup-for-cool-days": "Warming",
  "tremella-and-lotus-seed-sweet-soup-basics": "Moistening",
  "schisandra-and-jujube-tea-basics": "Calming",
  "monk-fruit-and-pear-tea-basics": "Cooling",
  "walnut-and-black-sesame-paste-basics": "Nourishing",
  "barley-sprout-and-chen-pi-tea-basics": "Digestive",
  "chinese-yam-and-jujube-porridge-basics": "Balanced",
};

const recipeCategories = Array.from(new Set(recipeCards.map((card) => recipeCategoryMap[card.slug] ?? "Balanced")));
---

<BaseLayout
  title="Kitchen Recipes | HerbGuide"
  description="Browse traditional kitchen recipes with ingredients, step-by-step instructions, pantry teas, simple soups, and beginner-friendly kitchen guidance."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "Kitchen Traditions",
      description:
        "Practical kitchen ideas with simple soups, teas, pantry basics, and beginner-friendly routines.",
      url: "https://herbguide.store/kitchen/",
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Are these kitchen pages the same as concentrated herb use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not necessarily. This section focuses on ingredient-level use such as soups, teas, porridges, and seasonal cooking.",
          },
        },
        {
          "@type": "Question",
          name: "What are the easiest kitchen ingredients to start with?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Ginger, jujube, goji berry, chrysanthemum, mint, black sesame, lotus seed, and pear are among the easiest beginner-friendly ingredients.",
          },
        },
        {
          "@type": "Question",
          name: "Do these kitchen pages include ingredients and step-by-step instructions?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. HerbGuide kitchen pages include ingredient lists, simple preparation steps, serving notes when helpful, and caution language when context matters.",
          },
        },
      ],
    },
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: "Kitchen Recipes",
      itemListElement: recipeCards.slice(0, 10).map((card, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: card.title,
        url: `https://herbguide.store/kitchen/${card.slug}/`,
      })),
    },
  ]}
>
  <section class="page-hero">
    <div class="shell narrow">
      <p class="eyebrow">Kitchen Traditions</p>
      <h1>Simple recipes and gentle routines</h1>
      <p>
        This section keeps traditional herb language practical through soups, teas, pantry guides, and seasonal
        kitchen ideas that are easier to try than dense theory.
      </p>
      <p>
        Readers often come here for traditional kitchen recipes, simple pantry tea ideas,
        or beginner-friendly warming and cooling kitchen guidance in plain English.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro
        title="Search recipe themes"
        text="Search by gentle outcome language like warming, cooling, nourishing, calming, light, digestive, breakfast, or dessert soup."
      />
      <div class="search-panel">
        <label class="sr-only" for="kitchen-search">Search kitchen pages</label>
        <input
          id="kitchen-search"
          type="search"
          placeholder="Search by warming, nourishing, digestive, calming, breakfast, tea, soup, or pantry"
        />
        <p class="search-note">Try words like warming, nourishing, digestive, calming, cooling, gentle, breakfast, or tea.</p>
      </div>
      <div class="filter-panel">
        <div class="filter-group">
          <p class="filter-label">Browse by recipe category</p>
          <div class="filter-row" id="kitchen-category-filters">
            <button class="filter-chip is-active" type="button" data-kitchen-category-filter="all">All categories</button>
            {recipeCategories.map((category) => (
              <button class="filter-chip" type="button" data-kitchen-category-filter={category}>{category}</button>
            ))}
          </div>
        </div>
      </div>
      <p class="results-count" id="kitchen-results-count">Showing all kitchen pages.</p>
      <SectionIntro
        title="Starter topics"
        text="These beginner-friendly recipe pages already include familiar ingredients, simple how-to steps, cultural context, and careful safety language."
      />
      <p class="search-empty" id="kitchen-search-empty" hidden>
        No kitchen pages matched that search yet. Try broader words like warming, nourishing, tea, soup, calming, or digestive.
      </p>
      <div class="stack" id="kitchen-results">
        {recipeCards.map((card) => (
          <article
            class="list-card kitchen-card"
            data-category={recipeCategoryMap[card.slug] ?? "Balanced"}
            data-search={`${card.title} ${card.text} ${recipeCategoryMap[card.slug] ?? "Balanced"} ${(recipeSearchThemes[card.slug] ?? []).join(" ")}`.toLowerCase()}
          >
            <h2><a href={`/kitchen/${card.slug}/`}>{card.title}</a></h2>
            <p>{card.text}</p>
            <p class="meta-label">Category: {recipeCategoryMap[card.slug] ?? "Balanced"}</p>
            <ul class="tag-list compact-tags">
              {(recipeSearchThemes[card.slug] ?? []).slice(0, 4).map((theme) => (
                <li>{theme}</li>
              ))}
            </ul>
            <p class="card-link"><a href={`/kitchen/${card.slug}/`}>Read ingredients and steps</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Reader questions</p>
        <h2>Kitchen recipes for beginners</h2>
        <p>
          Many readers come to this section looking for beginner-friendly traditional kitchen
          recipes, easy warming soups, pantry tea ideas, and simple dessert soups
          with ingredient lists and clear steps.
        </p>
        <p>
          The focus stays on usable recipes and kitchen context rather than vague lifestyle
          claims.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">New kitchen pages</p>
        <h2>Best new recipe-style articles</h2>
        <ul>
          <li><a href="/kitchen/mulberry-and-goji-tea-basics/">Mulberry and Goji Tea Basics</a></li>
          <li><a href="/kitchen/perilla-and-ginger-soup-for-cool-days/">Perilla and Ginger Soup for Cool Days</a></li>
          <li><a href="/kitchen/schisandra-and-jujube-tea-basics/">Schisandra and Jujube Tea Basics</a></li>
          <li><a href="/kitchen/goji-berry-porridge-for-gentle-mornings/">Goji Berry Porridge for Gentle Mornings</a></li>
          <li><a href="/kitchen/lotus-seed-and-longan-sweet-soup-basics/">Lotus Seed and Longan Sweet Soup Basics</a></li>
          <li><a href="/kitchen/chen-pi-tea-for-heavy-meal-days/">Chen Pi Tea for Heavy Meal Days</a></li>
          <li><a href="/kitchen/hawthorn-berry-tea-for-rich-meals/">Hawthorn Berry Tea for Rich Meals</a></li>
          <li><a href="/kitchen/black-sesame-and-jujube-breakfast-bowl/">Black Sesame and Jujube Breakfast Bowl</a></li>
          <li><a href="/kitchen/jobs-tears-porridge-for-heavy-days/">Job's Tears Porridge for Heavy Days</a></li>
          <li><a href="/kitchen/pear-and-chrysanthemum-tea-for-warm-afternoons/">Pear and Chrysanthemum Tea for Warm Afternoons</a></li>
          <li><a href="/kitchen/goji-and-chrysanthemum-tea-basics/">Goji and Chrysanthemum Tea Basics</a></li>
          <li><a href="/kitchen/jujube-and-lotus-seed-congee-for-quiet-evenings/">Jujube and Lotus Seed Congee for Quiet Evenings</a></li>
          <li><a href="/kitchen/tremella-and-pear-sweet-soup-basics/">Tremella and Pear Sweet Soup Basics</a></li>
          <li><a href="/kitchen/adzuki-bean-and-jobs-tears-soup-basics/">Adzuki Bean and Job's Tears Soup Basics</a></li>
          <li><a href="/kitchen/chinese-yam-and-carrot-soup-basics/">Chinese Yam and Carrot Soup Basics</a></li>
          <li><a href="/kitchen/tremella-and-lotus-seed-sweet-soup-basics/">Tremella and Lotus Seed Sweet Soup Basics</a></li>
          <li><a href="/kitchen/monk-fruit-and-pear-tea-basics/">Monk Fruit and Pear Tea Basics</a></li>
          <li><a href="/kitchen/walnut-and-black-sesame-paste-basics/">Walnut and Black Sesame Paste Basics</a></li>
          <li><a href="/kitchen/barley-sprout-and-chen-pi-tea-basics/">Barley Sprout and Chen Pi Tea Basics</a></li>
          <li><a href="/kitchen/chinese-yam-and-jujube-porridge-basics/">Chinese Yam and Jujube Porridge Basics</a></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Best first clicks</p>
        <h2>What to open after one kitchen recipe</h2>
        <p>
          If a reader lands on one practical page, a useful next step is usually either
          a pantry herb profile or a topic hub with more pages in the same style.
        </p>
        <p>
          The best follow-up pages right now are <a href="/topics/balanced-pantry-habits/">Balanced Pantry Habits</a>,
          <a href="/topics/evening-teas/">Evening Teas</a>, and the
          <a href="/herbs/"> Herb Library</a>.
        </p>
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Kitchen traditions</p>
        <h2>Kitchen guidance, not personal advice</h2>
        <p>
          This section sits at the meeting point of household cooking,
          seasonality, ingredient pairing, and traditional theory. It usually asks simple
          questions: is the weather dry or damp, cold or hot, light or heavy, and what
          kinds of everyday foods are commonly used in that setting?
        </p>
        <p>
          That is why this section focuses on teas, soups, porridge, pantry ingredients, and
          ingredient pairings. It is one of the easiest entry points for many readers,
          especially in American English educational content.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">How to use this section</p>
        <h2>Start with familiar ingredients</h2>
        <p>
          Beginner-friendly kitchen learning works best when the ingredients already feel
          recognizable. Ginger, jujube, goji berry, chrysanthemum, mint, pear, black sesame,
          and lotus seed are easier to trust than obscure concentrated products.
        </p>
        <ul>
          <li>Choose simple recipes with one clear theme.</li>
          <li>Prefer food-level use over concentrated self-directed use.</li>
          <li>Watch the cautions on individual herb pages.</li>
          <li>Use repeated gentle learning instead of exaggerated promises.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="shell two-up">
      <article class="prose-block list-card">
        <h2>Kitchen ideas for beginners</h2>
        <p>
          A warming soup article might center ginger, jujube, and astragalus in cold-weather
          cooking. A cooling tea article might introduce chrysanthemum or mint with simple
          language around traditional heat. A nourishing pantry article might explain why
          goji berry, black sesame, longan, or lotus seed show up so often in home recipes.
        </p>
        <p>
          The goal is to keep the section useful in the kitchen first. That creates a more
          trustworthy tone than jumping immediately into claim-heavy language.
        </p>
      </article>

      <article class="prose-block list-card">
        <h2>Traditional recipe pages without hype</h2>
        <p>
          Traditional kitchen content can sound gentle, but it still deserves boundaries. HerbGuide will
          not use recipe content to imply personal evaluation, direct care plans, replacement
          of ongoing routines, or individualized instructions for pregnancy, ongoing situations,
          or ongoing concerns.
        </p>
        <p>
          Readers should come away with cultural understanding, practical ingredient ideas,
          and a better vocabulary for reading traditional herb content online.
        </p>
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Everyday questions</p>
        <h2>Best kitchen ingredients for everyday cooking</h2>
        <p>
          This section works best when it answers very specific questions in plain English.
          That includes topics like beginner-friendly kitchen ingredients, easy
          warming soup ingredients for cold weather, and how to use goji berry, ginger,
          jujube, or chrysanthemum in everyday kitchen routines.
        </p>
        <p>
          These are the kinds of questions readers often ask when they are curious but still
          cautious. They fit HerbGuide better than aggressive claim-driven lifestyle
          language.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Recipe structure</p>
        <h2>Traditional soup recipes with step-by-step instructions</h2>
        <p>
          This section now includes detailed Chinese traditional soup recipes, pantry tea
          recipes with step-by-step instructions, and simple pantry-style bowls built around
          season, comfort, and familiar ingredients.
        </p>
        <p>
          Each page starts with a clear ingredient list, explains why those ingredients are
          traditionally paired, and walks through timing, simmering, preparation, and
          practical serving ideas.
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Reader questions</p>
        <h2>Kitchen traditions FAQ</h2>
        <h3>Are these kitchen pages the same as concentrated herb use?</h3>
        <p>
          Not necessarily. This style of content usually begins with ingredient-level use such as
          soups, teas, porridges, and seasonal cooking. It sits closer to the kitchen than
          to concentrated herbal use.
        </p>
        <h3>What are the easiest kitchen ingredients to start with?</h3>
        <p>
          Ginger, jujube, goji berry, chrysanthemum, mint, black sesame, lotus seed, and
          pear are among the easiest to explain because they already feel close to food.
        </p>
        <h3>Do HerbGuide recipe pages include full preparation steps?</h3>
        <p>
          Yes. Current kitchen pages include ingredients, exact preparation steps,
          and practical serving notes when they help the recipe feel easier to use.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Keep exploring</p>
        <h2>Best next reads for this section</h2>
        <p>
          If you want food-friendly herbs first, start with the herb profiles for
          <a href="/herbs/goji-berry/">Goji Berry</a>,
          <a href="/herbs/fresh-ginger/">Fresh Ginger</a>,
          <a href="/herbs/jujube-red-date/">Jujube</a>, and
          <a href="/herbs/chrysanthemum-flower/">Chrysanthemum</a>.
        </p>
        <p>
          If you want the theory behind warming, cooling, and seasonal ingredient choices,
          the next stop should be <a href="/basics/">Basics</a>.
        </p>
      </article>
    </div>
  </section>

  <script is:inline>
    const kitchenSearchInput = document.querySelector("#kitchen-search");
    const kitchenCards = Array.from(document.querySelectorAll(".kitchen-card"));
    const kitchenResultsCount = document.querySelector("#kitchen-results-count");
    const kitchenEmptyState = document.querySelector("#kitchen-search-empty");
    const kitchenCategoryButtons = Array.from(document.querySelectorAll("[data-kitchen-category-filter]"));
    let activeKitchenCategory = "all";

    const renderKitchenResults = () => {
      const value = kitchenSearchInput ? kitchenSearchInput.value.trim().toLowerCase() : "";
      let visibleCount = 0;

      kitchenCards.forEach((card) => {
        const haystack = card.dataset.search ?? "";
        const matchesSearch = haystack.includes(value);
        const matchesCategory =
          activeKitchenCategory === "all" || (card.dataset.category ?? "") === activeKitchenCategory;
        const isMatch = matchesSearch && matchesCategory;
        card.style.display = isMatch ? "" : "none";
        if (isMatch) {
          visibleCount += 1;
        }
      });

      if (kitchenResultsCount) {
        kitchenResultsCount.textContent =
          visibleCount === kitchenCards.length
            ? "Showing all kitchen pages."
            : `Showing ${visibleCount} kitchen page${visibleCount === 1 ? "" : "s"} after search.`;
      }

      if (kitchenEmptyState) {
        kitchenEmptyState.hidden = visibleCount > 0;
      }
    };

    if (kitchenSearchInput && kitchenCards.length > 0) {
      kitchenSearchInput.addEventListener("input", renderKitchenResults);
      kitchenSearchInput.addEventListener("search", renderKitchenResults);
      kitchenSearchInput.addEventListener("change", renderKitchenResults);
    }

    kitchenCategoryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeKitchenCategory = button.dataset.kitchenCategoryFilter ?? "all";
        kitchenCategoryButtons.forEach((item) =>
          item.classList.toggle("is-active", item === button),
        );
        renderKitchenResults();
      });
    });

    renderKitchenResults();
  </script>
</BaseLayout>
