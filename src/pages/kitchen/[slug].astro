    { title: "Monk Fruit and Pear Tea Basics", href: "/kitchen/monk-fruit-and-pear-tea-basics/" },
  ],
  "jasmine-and-pear-tea-basics": [
    { title: "Osmanthus and Pear Tea Basics", href: "/kitchen/osmanthus-and-pear-tea-basics/" },
    { title: "Rose Bud and Mulberry Leaf Tea Basics", href: "/kitchen/rose-bud-and-mulberry-leaf-tea-basics/" },
    { title: "Pear and Chrysanthemum Tea for Warm Afternoons", href: "/kitchen/pear-and-chrysanthemum-tea-for-warm-afternoons/" },
  ],
  "rose-bud-and-mulberry-leaf-tea-basics": [
    { title: "Jasmine and Pear Tea Basics", href: "/kitchen/jasmine-and-pear-tea-basics/" },
    { title: "Chrysanthemum and Mint Cooling Tea Basics", href: "/kitchen/chrysanthemum-and-mint-cooling-tea-basics/" },
    { title: "Pear and Chrysanthemum Tea for Warm Afternoons", href: "/kitchen/pear-and-chrysanthemum-tea-for-warm-afternoons/" },
  ],
  "lotus-leaf-and-burdock-root-tea-basics": [
    { title: "Rose Bud and Mulberry Leaf Tea Basics", href: "/kitchen/rose-bud-and-mulberry-leaf-tea-basics/" },
    { title: "Tangerine Peel and Pear Warm Tea Basics", href: "/kitchen/tangerine-peel-and-pear-warm-tea-basics/" },
    { title: "Chrysanthemum and Mint Cooling Tea Basics", href: "/kitchen/chrysanthemum-and-mint-cooling-tea-basics/" },
  ],
  "cassia-seed-and-corn-silk-tea-basics": [
    { title: "Lotus Leaf and Burdock Root Tea Basics", href: "/kitchen/lotus-leaf-and-burdock-root-tea-basics/" },
    { title: "Chrysanthemum and Mint Cooling Tea Basics", href: "/kitchen/chrysanthemum-and-mint-cooling-tea-basics/" },
    { title: "Pear and Chrysanthemum Tea for Warm Afternoons", href: "/kitchen/pear-and-chrysanthemum-tea-for-warm-afternoons/" },
  ],
  "lotus-root-soup-basics": [
    { title: "A Simple Warming Soup Guide for Cold Weather", href: "/kitchen/a-simple-warming-soup-guide-for-cold-weather/" },
    { title: "Chinese Yam and Carrot Soup Basics", href: "/kitchen/chinese-yam-and-carrot-soup-basics/" },
    { title: "Pear and Lily Bulb Soup for Dry Days", href: "/kitchen/pear-and-lily-bulb-soup-for-dry-days/" },
  ],
  "astragalus-and-jujube-chicken-broth": [
    { title: "A Simple Warming Soup Guide for Cold Weather", href: "/kitchen/a-simple-warming-soup-guide-for-cold-weather/" },
    { title: "Perilla and Ginger Soup for Cool Days", href: "/kitchen/perilla-and-ginger-soup-for-cool-days/" },
    { title: "Chinese Yam and Carrot Soup Basics", href: "/kitchen/chinese-yam-and-carrot-soup-basics/" },
  ],
};
const relatedRecipes = recipeLinkMap[article.slug] ?? [];
const articleKeywords = [
  article.title,
  ...relatedHerbs.map((herb) => herb.name),
  `${article.title} kitchen guide`,
  `${article.title} ingredients`,
  `${article.title} steps`,
  `${article.title} pantry notes`,
  "kitchen recipe",
  "tea recipe",
  "soup recipe",
  "ingredient guide",
  ...(articleSeo?.extraKeywords ?? []),
];
const recipeNutrition = {
  "@type": "NutritionInformation",
  calories: "120 kcal",
};
const formatDuration = (value: string) =>
  value
    .replace("PT", "")
    .replace("H", " hr ")
    .replace("M", " min")
    .trim();
const recipeSchema = article.recipe
  ? {
      "@context": "https://schema.org",
      "@type": "Recipe",
      name: article.title,
      description: article.description,
      image: [`https://herbguide.store${recipeImage.src}`],
      recipeYield: article.recipe.recipeYield,
      prepTime: article.recipe.prepTime,
      cookTime: article.recipe.totalTime,
      totalTime: article.recipe.totalTime,
      recipeCuisine: recipeCuisineMap[article.slug] ?? "Chinese-inspired kitchen",
      nutrition: recipeNutrition,
      recipeIngredient: article.recipe.ingredients,
      recipeInstructions: article.recipe.steps.map((step, index) => ({
        "@type": "HowToStep",
        name: `Step ${index + 1}`,
        text: step,
      })),
      mainEntityOfPage: `https://herbguide.store/kitchen/${article.slug}/`,
      keywords: articleKeywords,
      author: {
        "@type": "Organization",
        name: "HerbGuide",
      },
      isPartOf: {
        "@type": "CollectionPage",
        name: "Kitchen Traditions",
        url: "https://herbguide.store/kitchen/",
      },
      keywords: articleKeywords.join(", "),
    }
  : null;
const faqSchema = article.recipe
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name:
            article.slug === "jujube-and-ginger-tea-for-busy-weeks"
              ? "What ingredients are used in this jujube tea recipe?"
              : article.slug === "goji-berry-porridge-for-gentle-mornings"
                ? "What ingredients are used in this goji berry porridge recipe?"
                : article.slug === "chen-pi-tea-for-heavy-meal-days"
                  ? "What ingredients are used in this chen pi tea recipe?"
                  : `What ingredients are used in ${article.title}?`,
          acceptedAnswer: {
            "@type": "Answer",
            text: `${article.title} uses simple pantry ingredients and a short ingredient list designed for beginner-friendly kitchen reading.`,
          },
        },
        {
          "@type": "Question",
          name:
            article.slug === "jujube-and-ginger-tea-for-busy-weeks"
              ? "Does this jujube tea recipe include step-by-step preparation?"
              : article.slug === "goji-berry-porridge-for-gentle-mornings"
                ? "Does this goji berry porridge recipe include step-by-step preparation?"
                : article.slug === "chen-pi-tea-for-heavy-meal-days"
                  ? "Does this chen pi tea recipe include step-by-step preparation?"
                  : `Does ${article.title} include step-by-step preparation?`,
          acceptedAnswer: {
            "@type": "Answer",
            text: `Yes. This HerbGuide page includes ingredients, preparation steps, serving notes when helpful, and caution language for context.`,
          },
        },
        {
          "@type": "Question",
          name: `Is ${article.title} personal guidance?`,
          acceptedAnswer: {
            "@type": "Answer",
            text: `No. HerbGuide presents this page as educational kitchen content with traditional context, not as personal advice, individualized recommendations, or one-to-one guidance.`,
          },
        },
      ],
    }
  : null;
---

<BaseLayout
  title={articleSeo?.title ?? `${article.title} | Ingredients, Steps, and Kitchen Notes`}
  description={articleSeo?.description ?? `${article.description} Includes ingredients, preparation steps, and related herb links.`}
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: article.title,
      description: article.description,
      url: `https://herbguide.store/kitchen/${article.slug}/`,
      mainEntityOfPage: `https://herbguide.store/kitchen/${article.slug}/`,
      keywords: articleKeywords.join(", "),
      articleSection: "Kitchen Traditions",
      author: {
        "@type": "Organization",
        name: "HerbGuide",
      },
      publisher: {
        "@type": "Organization",
        name: "HerbGuide",
      },
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://herbguide.store/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Kitchen Traditions",
          item: "https://herbguide.store/kitchen/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: article.title,
          item: `https://herbguide.store/kitchen/${article.slug}/`,
        },
      ],
    },
    ...(faqSchema ? [faqSchema] : []),
    ...(recipeSchema ? [recipeSchema] : []),
  ]}
>
  <section class="page-hero">
    <div class="shell narrow prose-block">
      <p class="eyebrow">{article.eyebrow}</p>
      <h1>{article.title}</h1>
      <p>{article.intro}</p>
      {articleSeo?.heroNote && <p>{articleSeo.heroNote}</p>}
      {article.recipe && (
        <p>
          This recipe page includes ingredients, step-by-step preparation, and related herb links
          so readers can move from one kitchen idea into clearer ingredient context.
        </p>
      )}
      {article.recipe && (
        <figure class="card recipe-hero-media">
          <img src={recipePageVisual.src} alt={recipePageVisual.alt} loading="eager" />
        </figure>
      )}
    </div>
  </section>

  <section class="section">
    <div class="shell narrow stack">
      {article.recipe && (
        <article class="prose-block card">
          <p class="eyebrow">Quick guide</p>
          <h2>What this recipe page includes</h2>
          <p>
            This page explains the traditional kitchen context behind <strong>{article.title}</strong>,
            then shows the ingredient list, step-by-step method, related herb pages, and
            topic hubs for deeper reading.
          </p>
          <ul>
            <li><a href="#ingredients">Jump to the ingredient list</a></li>
            <li><a href="#steps">Jump to the preparation steps</a></li>
            <li><a href="#related-herbs">Open related herb profiles</a></li>
            {relatedRecipes.length > 0 && <li><a href="#related-recipes">Open related recipe pages</a></li>}
          </ul>
        </article>
      )}
      {article.sections.map((section) => (
        <article class="prose-block card">
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
        </article>
      ))}
      {article.recipe && (
        <>
          <div class="recipe-grid">
            <article class="prose-block card" id="ingredients">
              <p class="eyebrow">Recipe basics</p>
              <h2>Ingredients</h2>
              <p>
                Yield: {article.recipe.recipeYield} | Prep: {formatDuration(article.recipe.prepTime)} | Total: {formatDuration(article.recipe.totalTime)}
              </p>
              <ul>
                {article.recipe.ingredients.map((ingredient) => (
                  <li>{ingredient}</li>
                ))}
              </ul>
            </article>

            <article class="prose-block card" id="steps">
              <p class="eyebrow">Step by step</p>
              <h2>How to make it</h2>
              <ol class="recipe-steps">
                {article.recipe.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            </article>
          </div>
          {(article.recipe.servingNotes || article.recipe.caution) && (
            <div class="recipe-grid">
              {article.recipe.servingNotes && (
                <article class="prose-block card">
                  <p class="eyebrow">Serving notes</p>
                  <h2>Keep it simple</h2>
                  <ul>
                    {article.recipe.servingNotes.map((note) => (
                      <li>{note}</li>
                    ))}
                  </ul>
                </article>
              )}
              {article.recipe.caution && (
                <article class="prose-block caution-section">
                  <p class="eyebrow">Caution</p>
                  <h2>Read this recipe in context</h2>
                  <ul>
                    {article.recipe.caution.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </article>
              )}
            </div>
          )}
        </>
      )}
      <article class="prose-block card" id="related-herbs">
        <p class="eyebrow">Ingredient links</p>
        <h2>Related herb pages for this recipe</h2>
        <p>
          These kitchen pages perform best when they connect directly to ingredient profiles so
          readers can check traditional terms, food uses, and caution notes in one place.
        </p>
        <ul>
          {relatedHerbs.map((herb) => (
            <li><a href={herb.href}>{herb.name}</a></li>
          ))}
        </ul>
      </article>
      {relatedRecipes.length > 0 && (
        <article class="prose-block card" id="related-recipes">
          <p class="eyebrow">Next recipes</p>
          <h2>Related kitchen pages to open next</h2>
          <p>
            If this recipe matches what the reader wants, the best next click is usually another
            kitchen page with a similar ingredient, season, or pantry theme.
          </p>
          <ul>
            {relatedRecipes.map((recipe) => (
              <li><a href={recipe.href}>{recipe.title}</a></li>
            ))}
          </ul>
        </article>
      )}
      {article.references && article.references.length > 0 && (
        <article class="prose-block card">
          <p class="eyebrow">References</p>
          <h2>References</h2>
          {article.references.map((ref) => {
            const urlMatch = ref.match(/(https?:\/\/[^\s]+)/);
            const url = urlMatch ? urlMatch[1] : null;
            const label = url ? ref.replace(url, '').trim() : ref;
            return url ? (
              <p>{label} <a href={url} target="_blank" rel="noopener noreferrer">{url}</a></p>
            ) : (
              <p>{ref}</p>
            );
          })}
        </article>
      )}
      <article class="prose-block card">
        <p class="eyebrow">Keep exploring</p>
        <h2>Back to Kitchen Traditions</h2>
        <p>
          This article is part of the <a href="/kitchen/">Kitchen Traditions</a> section. Return
          there for more kitchen-focused reading and ingredient ideas.
        </p>
      </article>
      {relatedTopics.length > 0 && (
        <article class="prose-block card">
          <p class="eyebrow">Topic hubs</p>
          <h2>Continue this kitchen theme</h2>
          <ul>
            {relatedTopics.map((topic) => (
              <li><a href={`/topics/${topic.slug}/`}>{topic.title}</a></li>
            ))}
          </ul>
        </article>
      )}
    </div>
  </section>
</BaseLayout>
