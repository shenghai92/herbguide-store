---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { herbs } from "../../data/herbs";
import { getHerbEnhancement } from "../../data/herb-enhancements";
import { getTopicsForHerb } from "../../data/topics";

export function getStaticPaths() {
  return herbs.map((herb) => ({
    params: { slug: herb.slug },
    props: { herb },
  }));
}

const { herb } = Astro.props;
const relatedHerbs = herbs
  .filter((item) => item.slug !== herb.slug && item.category === herb.category)
  .slice(0, 3);
const fallbackHerbs = herbs.filter((item) => item.slug !== herb.slug).slice(0, 3);
const suggestedHerbs = relatedHerbs.length > 0 ? relatedHerbs : fallbackHerbs;
const relatedTopics = getTopicsForHerb(herb.slug);
const enhancement = getHerbEnhancement(herb.slug);
const herbKeywords = [
  herb.name,
  herb.pinyin,
  herb.chinese,
  herb.latin,
  herb.category,
  ...herb.tags,
  ...herb.foodUses,
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: `What is ${herb.name} in TCM?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `${herb.name} is presented on HerbGuide as a traditional Chinese herb profile with plain-English context, naming, category, kitchen uses where relevant, and a visible safety note.`,
      },
    },
    {
      "@type": "Question",
      name: `Does this ${herb.name} page include food use ideas?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `Yes. HerbGuide highlights approachable kitchen or food-adjacent uses whenever they help readers understand the herb more clearly, while keeping the page educational rather than prescriptive.`,
      },
    },
    {
      "@type": "Question",
      name: `Is ${herb.name} on HerbGuide medical advice?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `No. HerbGuide presents ${herb.name} as educational content about traditional terminology, cultural context, and safety boundaries, not as diagnosis or personalized treatment advice.`,
      },
    },
  ],
};
---

<BaseLayout
  title={`${herb.name} (${herb.pinyin}) | HerbGuide`}
  description={herb.summary}
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: `${herb.name} (${herb.pinyin})`,
      description: herb.summary,
      url: `https://herbguide.store/herbs/${herb.slug}/`,
      mainEntityOfPage: `https://herbguide.store/herbs/${herb.slug}/`,
      keywords: herbKeywords.join(", "),
      articleSection: herb.category,
      about: ["Traditional Chinese herbs", herb.name, herb.pinyin, herb.latin],
      author: {
        "@type": "Organization",
        name: "HerbGuide",
      },
      publisher: {
        "@type": "Organization",
        name: "HerbGuide",
      },
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://herbguide.store/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Herb Library",
          item: "https://herbguide.store/herbs/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: herb.name,
          item: `https://herbguide.store/herbs/${herb.slug}/`,
        },
      ],
    },
    faqSchema,
  ]}
>
  <section class="page-hero herb-detail-hero">
    <div class="shell herb-detail-grid">
      <div>
        <p class="eyebrow">{herb.category}</p>
        <h1>{herb.name}</h1>
        <p class="detail-subtitle">
          {herb.pinyin} | {herb.chinese} | {herb.latin}
        </p>
        <p>{herb.summary}</p>
      </div>
      <aside class="info-panel">
        <p class="eyebrow">Quick facts</p>
        <dl class="facts-grid">
          <div>
            <dt>Part used</dt>
            <dd>{herb.partUsed}</dd>
          </div>
          <div>
            <dt>Nature</dt>
            <dd>{herb.nature}</dd>
          </div>
          <div>
            <dt>Flavor</dt>
            <dd>{herb.flavor}</dd>
          </div>
          <div>
            <dt>Channel entry</dt>
            <dd>{herb.channels}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell herb-body-grid">
      <article class="prose-block stack">
        <article class="prose-block card detail-jump-card">
          <p class="eyebrow">Quick guide</p>
          <h2>How to use this herb page</h2>
          <p>
            This page is structured to help readers move from naming and traditional context
            into kitchen use, comparison links, and caution notes without scrolling blindly.
          </p>
          <ul>
            <li><a href="#what-this-herb-is">Jump to what this herb is</a></li>
            <li><a href="#how-tcm-describes-it">Jump to traditional description</a></li>
            <li><a href="#kitchen-uses">Jump to common kitchen uses</a></li>
            <li><a href="#safety-note">Jump to the safety note</a></li>
          </ul>
        </article>

        <section class="detail-section card" id="what-this-herb-is">
          <h2>What this herb is</h2>
          <p>{herb.whatItIs}</p>
          <p>
            We show the English name, pinyin, Chinese characters, and Latin name together
            so readers can connect grocery familiarity, traditional terminology, and
            reference naming in one place.
          </p>
        </section>

        <section class="detail-section card" id="how-tcm-describes-it">
          <h2>How TCM describes it</h2>
          <p>
            In TCM language, <strong>nature</strong> describes whether a herb is warming,
            cooling, neutral, and so on. <strong>Flavor</strong> refers to a traditional
            framework such as sweet, bitter, pungent, sour, or salty, each with its own
            functional associations.
          </p>
          <ul>
            <li><strong>Nature:</strong> {herb.nature}</li>
            <li><strong>Flavor:</strong> {herb.flavor}</li>
            <li><strong>Traditionally associated with:</strong> {herb.channels}</li>
          </ul>
          <p>
            <strong>Channel entry</strong> is a TCM term. It describes traditional
            functional relationships, not a direct claim about modern anatomy.
          </p>
        </section>

        <section class="detail-section card">
          <h2>Traditional uses in plain English</h2>
          <ul>
            {herb.traditionalUses.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section class="detail-section card" id="kitchen-uses">
          <h2>Common kitchen uses</h2>
          <p>
            This site focuses on practical, kitchen-adjacent learning whenever possible.
            For {herb.name}, the most approachable formats are:
          </p>
          <ul>
            {herb.foodUses.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        {enhancement?.kitchenPairings && (
          <section class="detail-section card">
            <h2>Common pairings and reading paths</h2>
            <p>
              Readers often understand a herb faster when they see what it tends to be paired
              with in soups, teas, pantry routines, or comparison pages.
            </p>
            <ul>
              {enhancement.kitchenPairings.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        {enhancement?.goodStartingPoints && (
          <section class="detail-section card">
            <h2>Best way to start with this page</h2>
            <ul>
              {enhancement.goodStartingPoints.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        <section class="detail-section card">
          <h2>How to read this page in context</h2>
          <p>
            A herb profile is an educational overview, not a full practice guide. In
            traditional practice, herbs are often combined, prepared in different ways, and
            interpreted according to pattern, constitution, season, and dose.
          </p>
          <p>
            That is why HerbGuide emphasizes careful wording, cultural context, food use
            examples, and safety notes instead of presenting any one herb as a universal
            answer.
          </p>
        </section>

        <section class="detail-section caution-section" id="safety-note">
          <h2>Safety note</h2>
          <p>{herb.caution}</p>
          <p>
            HerbGuide is an educational resource. This page does not provide diagnosis,
            treatment advice, or a recommendation that this herb is appropriate for any specific
            person.
          </p>
        </section>
      </article>

      <aside class="detail-sidebar">
        <div class="sidebar-card">
          <p class="eyebrow">Tags</p>
          <ul class="tag-list">
            {herb.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </div>
        <div class="sidebar-card">
          <p class="eyebrow">Keep exploring</p>
          <p>
            Use the full library if you want to compare this herb with other foods, roots,
            flowers, and pantry-style ingredients.
          </p>
          <p class="card-link">
            <a href="/herbs/">Back to Herb Library</a>
          </p>
        </div>
        <div class="sidebar-card">
          <p class="eyebrow">Related herbs</p>
          <ul class="related-links">
            {suggestedHerbs.map((item) => (
              <li><a href={`/herbs/${item.slug}/`}>{item.name}</a></li>
            ))}
          </ul>
        </div>
        {relatedTopics.length > 0 && (
          <div class="sidebar-card">
            <p class="eyebrow">Topic hubs</p>
            <ul class="related-links">
              {relatedTopics.map((topic) => (
                <li><a href={`/topics/${topic.slug}/`}>{topic.title}</a></li>
              ))}
            </ul>
          </div>
        )}
        {enhancement?.compareLinks && (
          <div class="sidebar-card">
            <p class="eyebrow">Compare and learn</p>
            <ul class="related-links">
              {enhancement.compareLinks.map((link) => (
                <li><a href={link.href}>{link.title}</a></li>
              ))}
            </ul>
          </div>
        )}
        <div class="sidebar-card">
          <p class="eyebrow">Reader questions</p>
          <h2 class="sidebar-heading">Quick answers</h2>
          <ul class="related-links">
            <li>{herb.name} is explained here as an educational herb profile, not a product recommendation.</li>
            <li>Kitchen and pantry uses are included when they make the herb easier to understand.</li>
            <li>Safety context stays visible because not every herb is meant for casual self-use.</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
