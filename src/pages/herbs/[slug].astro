---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getHerbDisplayNames, herbs } from "../../data/herbs";
import { getHerbEnhancement } from "../../data/herb-enhancements";
import { getTopicsForHerb } from "../../data/topics";
import { basicsCards, recipeCards } from "../../data/content";

export function getStaticPaths() {
  return herbs.map((herb) => ({
    params: { slug: herb.slug },
    props: { herb },
  }));
}

const { herb } = Astro.props;
const relatedHerbs = herbs
  .filter((item) => item.slug !== herb.slug && item.category === herb.category)
  .slice(0, 3);
const fallbackHerbs = herbs.filter((item) => item.slug !== herb.slug).slice(0, 3);
const suggestedHerbs = relatedHerbs.length > 0 ? relatedHerbs : fallbackHerbs;
const relatedTopics = getTopicsForHerb(herb.slug);
const enhancement = getHerbEnhancement(herb.slug);
const detailNameParts = getHerbDisplayNames(herb).secondary;
const basicsBySlug: Record<string, string[]> = {
  "goji-berry": ["goji-berry-vs-jujube", "goji-berry-tea-vs-goji-berry-porridge", "what-does-nourish-blood-mean"],
  "astragalus-root": ["what-does-tonify-mean", "what-does-qi-mean", "what-does-spleen-mean"],
  "fresh-ginger": ["fresh-ginger-vs-dried-ginger", "warming-vs-cooling-foods", "what-is-food-stagnation"],
  "jujube-red-date": ["goji-berry-vs-jujube", "what-does-shen-mean", "what-does-nourish-blood-mean"],
  "chrysanthemum-flower": ["what-does-clear-heat-mean", "chrysanthemum-vs-mint", "warming-vs-cooling-foods"],
  "hawthorn-berry": ["chen-pi-vs-hawthorn-berry", "what-is-food-stagnation", "what-is-dampness"],
  "chen-pi": ["chen-pi-vs-hawthorn-berry", "what-is-food-stagnation", "what-is-qi-stagnation"],
  "tangerine-peel": ["chen-pi-vs-hawthorn-berry", "what-is-food-stagnation", "what-is-qi-stagnation"],
  "dried-orange-peel": ["warming-vs-cooling-foods", "what-is-food-stagnation", "what-does-spleen-mean"],
  "poria": ["what-is-dampness", "poria-vs-jobs-tears", "what-is-damp-heat"],
  "licorice-root": ["what-does-harmonizing-mean", "what-does-tonify-mean", "what-does-spleen-mean"],
  "schisandra-berry": ["what-does-astringent-mean", "what-does-shen-mean", "what-does-jing-mean"],
  "lotus-seed": ["what-does-astringent-mean", "what-does-shen-mean", "what-does-nourish-blood-mean"],
  "mulberry-fruit": ["mulberry-fruit-vs-goji-berry", "what-does-moisten-dryness-mean", "what-does-yin-deficiency-mean"],
  "black-sesame-seed": ["what-does-jing-mean", "what-does-nourish-blood-mean", "goji-berry-tea-vs-goji-berry-porridge"],
  "mint": ["chrysanthemum-vs-mint", "what-does-clear-heat-mean", "warming-vs-cooling-foods"],
  "tremella-mushroom": ["what-does-moisten-dryness-mean", "what-does-yin-deficiency-mean", "mulberry-fruit-vs-goji-berry"],
  "osmanthus-flower": ["warming-vs-cooling-foods", "what-does-clear-heat-mean", "what-is-traditional-herb-theory"],
  "jasmine-flower": ["warming-vs-cooling-foods", "chrysanthemum-vs-mint", "what-is-traditional-herb-theory"],
  "rose-bud": ["what-is-qi-stagnation", "warming-vs-cooling-foods", "what-is-traditional-herb-theory"],
  "mulberry-leaf": ["what-does-clear-heat-mean", "warming-vs-cooling-foods", "what-does-moisten-dryness-mean"],
  "lotus-leaf": ["warming-vs-cooling-foods", "what-is-traditional-herb-theory", "what-does-channel-entry-mean"],
  "burdock-root": ["what-does-channel-entry-mean", "what-does-clear-heat-mean", "warming-vs-cooling-foods"],
};
const suggestedBasics = (basicsBySlug[herb.slug] ?? ["what-is-traditional-herb-theory", "what-does-channel-entry-mean", "warming-vs-cooling-foods"])
  .map((slug) => basicsCards.find((item) => item.slug === slug))
  .filter(Boolean);
const recipesBySlug: Record<string, string[]> = {
  "goji-berry": ["goji-berry-porridge-for-gentle-mornings", "goji-and-chrysanthemum-tea-basics", "mulberry-and-goji-tea-basics"],
  "astragalus-root": ["a-simple-warming-soup-guide-for-cold-weather", "jujube-and-ginger-tea-for-busy-weeks"],
  "fresh-ginger": ["jujube-and-ginger-tea-for-busy-weeks", "perilla-and-ginger-soup-for-cool-days", "a-simple-warming-soup-guide-for-cold-weather"],
  "jujube-red-date": ["jujube-and-ginger-tea-for-busy-weeks", "jujube-and-lotus-seed-congee-for-quiet-evenings", "schisandra-and-jujube-tea-basics"],
  "chrysanthemum-flower": ["chrysanthemum-and-mint-cooling-tea-basics", "pear-and-chrysanthemum-tea-for-warm-afternoons", "goji-and-chrysanthemum-tea-basics"],
  "hawthorn-berry": ["hawthorn-berry-tea-for-rich-meals", "chen-pi-tea-for-heavy-meal-days"],
  "chen-pi": ["chen-pi-tea-for-heavy-meal-days", "hawthorn-berry-tea-for-rich-meals"],
  "tangerine-peel": ["tangerine-peel-and-pear-warm-tea-basics", "chen-pi-tea-for-heavy-meal-days"],
  "dried-orange-peel": ["tangerine-peel-and-pear-warm-tea-basics", "monk-fruit-and-pear-tea-basics"],
  "poria": ["jobs-tears-porridge-for-heavy-days", "adzuki-bean-and-jobs-tears-soup-basics"],
  "licorice-root": ["jujube-and-ginger-tea-for-busy-weeks", "a-simple-warming-soup-guide-for-cold-weather"],
  "schisandra-berry": ["schisandra-and-jujube-tea-basics", "lotus-seed-and-longan-sweet-soup-basics"],
  "chinese-yam": ["chinese-yam-and-carrot-soup-basics", "a-simple-warming-soup-guide-for-cold-weather"],
  "lotus-seed": ["lotus-seed-and-longan-sweet-soup-basics", "jujube-and-lotus-seed-congee-for-quiet-evenings", "tremella-and-lotus-seed-sweet-soup-basics"],
  "jobs-tears": ["jobs-tears-porridge-for-heavy-days", "adzuki-bean-and-jobs-tears-soup-basics"],
  "mulberry-fruit": ["mulberry-and-goji-tea-basics", "tremella-and-pear-sweet-soup-basics"],
  "black-sesame-seed": ["black-sesame-breakfast-ideas-for-beginners", "black-sesame-and-jujube-breakfast-bowl"],
  "mint": ["chrysanthemum-and-mint-cooling-tea-basics", "pear-and-chrysanthemum-tea-for-warm-afternoons"],
  "perilla-leaf": ["perilla-and-ginger-soup-for-cool-days"],
  "tremella-mushroom": ["tremella-and-pear-sweet-soup-basics", "tremella-and-lotus-seed-sweet-soup-basics"],
  "adzuki-bean": ["adzuki-bean-and-jobs-tears-soup-basics", "jobs-tears-porridge-for-heavy-days"],
  "osmanthus-flower": ["osmanthus-and-pear-tea-basics", "pear-and-chrysanthemum-tea-for-warm-afternoons"],
  "jasmine-flower": ["osmanthus-and-pear-tea-basics", "chrysanthemum-and-mint-cooling-tea-basics"],
  "rose-bud": ["rose-bud-and-mulberry-leaf-tea-basics", "osmanthus-and-pear-tea-basics"],
  "mulberry-leaf": ["rose-bud-and-mulberry-leaf-tea-basics", "pear-and-chrysanthemum-tea-for-warm-afternoons"],
  "lotus-leaf": ["lotus-leaf-and-burdock-root-tea-basics", "chrysanthemum-and-mint-cooling-tea-basics"],
  "burdock-root": ["lotus-leaf-and-burdock-root-tea-basics", "tangerine-peel-and-pear-warm-tea-basics"],
};
const suggestedRecipes = (recipesBySlug[herb.slug] ?? [])
  .map((slug) => recipeCards.find((item) => item.slug === slug))
  .filter(Boolean);
const herbHeroImageMap: Record<string, { src: string; alt: string }> = {
  "osmanthus-flower": {
    src: "/images/herbs/osmanthus-flower.svg",
    alt: "An illustration of sweet osmanthus blossoms with warm floral tea tones.",
  },
  "jasmine-flower": {
    src: "/images/herbs/jasmine-flower.svg",
    alt: "An illustration of jasmine blossoms styled for a floral tea herb page.",
  },
  "rose-bud": {
    src: "/images/herbs/rose-bud.svg",
    alt: "An illustration of rose buds arranged for a floral tea herb page.",
  },
  "mulberry-leaf": {
    src: "/images/herbs/mulberry-leaf.svg",
    alt: "An illustration of mulberry leaves styled for a seasonal tea herb page.",
  },
  "lotus-leaf": {
    src: "/images/herbs/lotus-leaf.svg",
    alt: "An illustration of lotus leaves styled for a seasonal tea herb page.",
  },
  "burdock-root": {
    src: "/images/herbs/burdock-root.svg",
    alt: "An illustration of sliced burdock root for an earthy tea herb page.",
  },
};
const herbHeroImage = herbHeroImageMap[herb.slug];
const herbKeywords = [
  herb.name,
  herb.pinyin,
  herb.chinese,
  herb.latin,
  herb.category,
  `${herb.name} guide`,
  `what is ${herb.name}`,
  `${herb.name} traditional context`,
  `${herb.name} kitchen notes`,
  `${herb.name} safety`,
  ...herb.tags,
  ...herb.foodUses,
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: `What is ${herb.name} in traditional herb writing?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `${herb.name} is presented on HerbGuide as a herb profile with plain-English context, naming, category, kitchen uses where relevant, and a visible safety note.`,
      },
    },
    {
      "@type": "Question",
      name: `Does this ${herb.name} page include food use ideas?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `Yes. HerbGuide highlights approachable kitchen or food-adjacent uses whenever they help readers understand the herb more clearly, while keeping the page educational rather than prescriptive.`,
      },
    },
    {
      "@type": "Question",
      name: `Is ${herb.name} on HerbGuide personal guidance?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `No. HerbGuide presents ${herb.name} as educational content about traditional terminology, cultural context, and safety boundaries, not as individualized advice or one-to-one guidance.`,
      },
    },
  ],
};
---

<BaseLayout
  title={`${herb.name} (${herb.pinyin}) Guide, Context, and Safety | HerbGuide`}
  description={`${herb.summary} Learn names, traditional context, kitchen notes, and safety language in plain English.`}
  type="article"
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: `${herb.name} (${herb.pinyin})`,
      description: herb.summary,
      url: `https://herbguide.store/herbs/${herb.slug}/`,
      mainEntityOfPage: `https://herbguide.store/herbs/${herb.slug}/`,
      keywords: herbKeywords.join(", "),
      articleSection: herb.category,
      about: ["traditional herbs", herb.name, herb.pinyin, herb.latin],
      author: {
        "@type": "Organization",
        name: "HerbGuide",
      },
      publisher: {
        "@type": "Organization",
        name: "HerbGuide",
      },
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://herbguide.store/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Herb Library",
          item: "https://herbguide.store/herbs/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: herb.name,
          item: `https://herbguide.store/herbs/${herb.slug}/`,
        },
      ],
    },
    faqSchema,
  ]}
>
  <section class="page-hero herb-detail-hero">
    <div class="shell herb-detail-grid">
      <div>
        <p class="eyebrow">{herb.category}</p>
        <h1>{herb.name}</h1>
        <p class="detail-subtitle">{detailNameParts.join(" | ")}</p>
        <p>{herb.summary}</p>
        <p>
          This guide helps readers understand what {herb.name} is, how traditional writing
          describes it, where it shows up in tea or kitchen reading, and what cautions belong on the page.
        </p>
        {herbHeroImage && (
          <figure class="card herb-hero-media">
            <img src={herbHeroImage.src} alt={herbHeroImage.alt} loading="eager" />
          </figure>
        )}
      </div>
      <aside class="info-panel">
        <p class="eyebrow">Quick facts</p>
        <dl class="facts-grid">
          <div>
            <dt>Part used</dt>
            <dd>{herb.partUsed}</dd>
          </div>
          <div>
            <dt>Nature</dt>
            <dd>{herb.nature}</dd>
          </div>
          <div>
            <dt>Flavor</dt>
            <dd>{herb.flavor}</dd>
          </div>
          <div>
            <dt>Channel entry</dt>
            <dd>{herb.channels}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell herb-body-grid">
      <article class="prose-block stack">
        <article class="prose-block card detail-jump-card">
          <p class="eyebrow">Quick guide</p>
          <h2>How to read this herb page</h2>
          <p>
            This page is structured to help readers move from naming and traditional context
            into kitchen use, comparison links, and caution notes without scrolling blindly.
          </p>
          <ul>
            <li><a href="#what-this-herb-is">Jump to what this herb is</a></li>
            <li><a href="#how-tcm-describes-it">Jump to traditional description</a></li>
            <li><a href="#kitchen-uses">Jump to common kitchen uses</a></li>
            <li><a href="#safety-note">Jump to the safety note</a></li>
          </ul>
        </article>

        <section class="detail-section card" id="what-this-herb-is">
          <h2>What this herb is</h2>
          <p>{herb.whatItIs}</p>
          <p>
            We show the English name, pinyin, Chinese characters, and Latin name together
            so readers can connect grocery familiarity, traditional terminology, and
            reference naming in one place.
          </p>
        </section>

        <section class="detail-section card" id="how-tcm-describes-it">
          <h2>How traditional writing groups it</h2>
          <p>
            In traditional language, <strong>nature</strong> describes whether a herb is warming,
            cooling, neutral, and so on. <strong>Flavor</strong> refers to a traditional
            framework such as sweet, bitter, pungent, sour, or salty, each with its own
            functional associations.
          </p>
          <ul>
            <li><strong>Nature:</strong> {herb.nature}</li>
            <li><strong>Flavor:</strong> {herb.flavor}</li>
            <li><strong>Traditionally associated with:</strong> {herb.channels}</li>
          </ul>
          <p>
            <strong>Channel entry</strong> is a traditional term. It describes traditional
            functional relationships, not a direct claim about modern anatomy.
          </p>
        </section>

        <section class="detail-section card">
          <h2>Traditional context in plain English</h2>
          <ul>
            {herb.traditionalUses.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section class="detail-section card" id="kitchen-uses">
          <h2>Common kitchen notes</h2>
          <p>
            This site focuses on practical, kitchen-adjacent learning whenever possible.
            For {herb.name}, the most approachable formats are:
          </p>
          <ul>
            {herb.foodUses.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          {suggestedRecipes.length > 0 && (
            <p>
              For practical examples, continue to{" "}
              {suggestedRecipes.slice(0, 2).map((item, index) => (
                <>
                  {index > 0 && (index === suggestedRecipes.slice(0, 2).length - 1 ? " and " : ", ")}
                  <a href={`/kitchen/${item.slug}/`}>{item.title}</a>
                </>
              ))}
              .
            </p>
          )}
        </section>

        {enhancement?.kitchenPairings && (
          <section class="detail-section card">
            <h2>Common pairings and reading paths</h2>
            <p>
              Readers often understand a herb faster when they see what it tends to be paired
              with in soups, teas, pantry routines, or comparison pages.
            </p>
            <ul>
              {enhancement.kitchenPairings.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        {enhancement?.goodStartingPoints && (
          <section class="detail-section card">
            <h2>Best way to start with this page</h2>
            <ul>
              {enhancement.goodStartingPoints.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        <section class="detail-section card">
          <h2>How to read this page in context</h2>
          <p>
            A herb profile is an educational overview, not a full practice guide. In
            traditional practice, herbs are often combined, prepared in different ways, and
            interpreted according to pattern, constitution, season, and dose.
          </p>
          <p>
            That is why HerbGuide emphasizes careful wording, cultural context, food use
            examples, and safety notes instead of presenting any one herb as a universal
            answer.
          </p>
          {(relatedTopics.length > 0 || suggestedBasics.length > 0) && (
            <p>
              A better next step is to pair this profile with
              {relatedTopics.length > 0 && (
                <>
                  {" "}
                  <a href={`/topics/${relatedTopics[0].slug}/`}>{relatedTopics[0].title}</a>
                </>
              )}
              {relatedTopics.length > 0 && suggestedBasics.length > 0 && " and "}
              {suggestedBasics.length > 0 && (
                <>
                  <a href={`/basics/${suggestedBasics[0].slug}/`}>{suggestedBasics[0].title}</a>
                </>
              )}
              .
            </p>
          )}
        </section>

        <section class="detail-section caution-section" id="safety-note">
          <h2>Safety note</h2>
          <p>{herb.caution}</p>
          <p>
            HerbGuide is an educational resource. This page does not provide personal
            advice, individualized recommendations, or a claim that this herb is appropriate for
            any specific person.
          </p>
        </section>
      </article>

      <aside class="detail-sidebar">
        <div class="sidebar-card">
          <p class="eyebrow">Tags</p>
          <ul class="tag-list">
            {herb.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </div>
        <div class="sidebar-card">
          <p class="eyebrow">Keep exploring</p>
          <p>
            Use the full library if you want to compare this herb with other foods, roots,
            flowers, and pantry-style ingredients.
          </p>
          <p class="card-link">
            <a href="/herbs/">Back to Herb Library</a>
          </p>
        </div>
        <div class="sidebar-card">
          <p class="eyebrow">Related herbs</p>
          <ul class="related-links">
            {suggestedHerbs.map((item) => (
              <li><a href={`/herbs/${item.slug}/`}>{item.name}</a></li>
            ))}
          </ul>
        </div>
        {relatedTopics.length > 0 && (
          <div class="sidebar-card">
            <p class="eyebrow">Topic hubs</p>
            <ul class="related-links">
              {relatedTopics.map((topic) => (
                <li><a href={`/topics/${topic.slug}/`}>{topic.title}</a></li>
              ))}
            </ul>
          </div>
        )}
        {enhancement?.compareLinks && (
          <div class="sidebar-card">
            <p class="eyebrow">Compare and learn</p>
            <ul class="related-links">
              {enhancement.compareLinks.map((link) => (
                <li><a href={link.href}>{link.title}</a></li>
              ))}
            </ul>
          </div>
        )}
        {suggestedBasics.length > 0 && (
          <div class="sidebar-card">
            <p class="eyebrow">Basics to read next</p>
            <ul class="related-links">
              {suggestedBasics.map((item) => (
                <li><a href={`/basics/${item.slug}/`}>{item.title}</a></li>
              ))}
            </ul>
          </div>
        )}
        {suggestedRecipes.length > 0 && (
          <div class="sidebar-card">
            <p class="eyebrow">Recipe paths</p>
            <ul class="related-links">
              {suggestedRecipes.map((item) => (
                <li><a href={`/kitchen/${item.slug}/`}>{item.title}</a></li>
              ))}
            </ul>
          </div>
        )}
        <div class="sidebar-card">
          <p class="eyebrow">Reader questions</p>
          <h2 class="sidebar-heading">Quick answers</h2>
          <ul class="related-links">
            <li>{herb.name} is explained here as an educational herb profile, not a product recommendation.</li>
            <li>Kitchen and pantry uses are included when they make the herb easier to understand.</li>
            <li>Safety context stays visible because not every herb is meant for casual self-use.</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
