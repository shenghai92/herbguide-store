---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import { featuredHerbs, herbs } from "../../data/herbs";

const herbCategories = Array.from(new Set(herbs.map((herb) => herb.category))).sort();
const herbLetters = Array.from(new Set(herbs.map((herb) => herb.name[0].toUpperCase()))).sort();
---

<BaseLayout
  title="Herb Library | HerbGuide"
  description="Browse beginner-friendly Traditional Chinese herb profiles with plain-English summaries and food tradition context."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "Herb Library",
      description:
        "Browse beginner-friendly Traditional Chinese herb profiles with plain-English summaries and food tradition context.",
      url: "https://herbguide.store/herbs/",
    },
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      itemListElement: herbs.slice(0, 10).map((herb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: `https://herbguide.store/herbs/${herb.slug}/`,
        name: herb.name,
      })),
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Can I search by Chinese name or pinyin?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. The Herb Library search is designed to work with English names, pinyin, Chinese characters, tags, and common food uses.",
          },
        },
        {
          "@type": "Question",
          name: "Which herbs are best for beginners?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Goji berry, fresh ginger, jujube, chrysanthemum, black sesame, and lotus seed are among the easiest herbs to understand because they sit close to everyday food use.",
          },
        },
        {
          "@type": "Question",
          name: "Are all herbs here meant for beginners to try on their own?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Some pages are food-friendly and beginner-oriented, while others are included for educational depth and should be read more cautiously.",
          },
        },
      ],
    },
  ]}
>
  <section class="page-hero">
    <div class="shell narrow">
      <p class="eyebrow">Herb Library</p>
      <h1>Beginner-friendly herb profiles</h1>
      <p>
        Every herb has its own dedicated page. Use the library search, category filters, and
        alphabet filters to jump directly to the herb a reader wants instead of making them
        scroll through an oversized list.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro
        title="Search the herb library"
        text="This version keeps herb browsing fast with client-side search plus simple filters, so the library can stay usable even as the total herb count keeps growing."
      />
      <div class="search-panel">
        <label class="sr-only" for="herb-search">Search herbs</label>
        <input
          id="herb-search"
          type="search"
          placeholder="Search by English name, pinyin, Chinese name, tag, or use"
        />
        <p class="search-note">Start with terms like goji, huang qi, tea, digestive, or warming.</p>
      </div>
      <div class="filter-panel">
        <div class="filter-group">
          <p class="filter-label">Browse by category</p>
          <div class="filter-row" id="category-filters">
            <button class="filter-chip is-active" type="button" data-category-filter="all">All categories</button>
            {herbCategories.map((category) => (
              <button class="filter-chip" type="button" data-category-filter={category}>{category}</button>
            ))}
          </div>
        </div>
        <div class="filter-group">
          <p class="filter-label">Jump by letter</p>
          <div class="filter-row" id="letter-filters">
            <button class="filter-chip is-active" type="button" data-letter-filter="all">All letters</button>
            {herbLetters.map((letter) => (
              <button class="filter-chip filter-chip-small" type="button" data-letter-filter={letter}>{letter}</button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro
        eyebrow="Best first clicks"
        title="Start with the easiest food-friendly herbs"
        text="These herbs are the strongest first clicks for new readers because they connect naturally to tea, soup, porridge, and practical kitchen learning."
      />
      <div class="card-grid">
        {featuredHerbs.map((herb) => (
          <article class="card">
            <p class="eyebrow">{herb.pinyin} | {herb.chinese}</p>
            <h2><a href={`/herbs/${herb.slug}/`}>{herb.name}</a></h2>
            <p>{herb.summary}</p>
            <p class="meta-label">Category: {herb.category}</p>
            <p class="card-link">
              <a href={`/herbs/${herb.slug}/`}>Open herb page</a>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro
        eyebrow="Compact directory"
        title="Browse the full herb library without endless scrolling"
        text="The full library now uses a denser directory layout. Search, category filters, and letter filters work together so the page stays usable as the site grows."
      />
      <p class="search-empty" id="search-empty" hidden>
        No herbs matched that search yet. Try an English name, pinyin, a food use, or a
        broader term like tea or soup.
      </p>
      <p class="results-count" id="results-count">Showing all herbs in the library.</p>
      <div class="directory-grid" id="herb-results">
        {herbs.map((herb) => (
          <article
            class="directory-card herb-card"
            data-category={herb.category}
            data-letter={herb.name[0].toUpperCase()}
            data-search={`${herb.name} ${herb.pinyin} ${herb.chinese} ${herb.summary} ${herb.tags.join(" ")} ${herb.foodUses.join(" ")}`.toLowerCase()}
          >
            <p class="eyebrow">{herb.pinyin} | {herb.chinese}</p>
            <h2><a href={`/herbs/${herb.slug}/`}>{herb.name}</a></h2>
            <p>{herb.summary}</p>
            <div class="directory-meta">
              <p class="meta-label">Category: {herb.category}</p>
              <p class="meta-label">Nature: {herb.nature}</p>
            </div>
            <ul class="tag-list compact-tags">
              {herb.foodUses.slice(0, 3).map((use) => (
                <li>{use}</li>
              ))}
              {herb.tags.slice(0, 2).map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <p class="card-link">
              <a href={`/herbs/${herb.slug}/`}>Open herb page</a>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">How to use this library</p>
        <h2>Browse Chinese herbs by name, use, and traditional category</h2>
        <p>
          This herb library is built for readers who want a beginner-friendly way to
          explore Chinese herbs without getting lost in untranslated terminology. Each herb
          page includes the English name, pinyin, Chinese characters, Latin name,
          traditional nature and flavor, channel entry, food use ideas where appropriate,
          and a visible safety note.
        </p>
        <p>
          The easiest way to use the library is to search by the word you already know.
          Some readers search by English name such as goji berry or ginseng. Others search
          by pinyin such as Huang Qi, Dang Shen, or Bai He. Many also search by broad goals
          like digestive, tea, soup, warming, cooling, or food tradition.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">What makes this different</p>
        <h2>Traditional Chinese herb profiles in plain English</h2>
        <p>
          Many herb sites either oversimplify Chinese herbs into marketing slogans or bury
          readers under technical jargon. HerbGuide takes a middle path. We keep the
          traditional framework visible, but we explain the terms carefully and avoid
          overstated promises.
        </p>
        <p>
          That makes this page useful for readers searching for Chinese herbs explained in
          English, how to understand pinyin herb names, or where to start with food-friendly
          Chinese herbs before moving into more advanced material.
        </p>
        <p>
          If you are learning the vocabulary behind these pages, continue to the
          <a href="/glossary/"> TCM Glossary</a> for direct term-by-term explanations.
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Reader questions</p>
        <h2>Herb library FAQ</h2>
        <h3>Can I search by Chinese name or pinyin?</h3>
        <p>
          Yes. The search box is designed to work with English names, pinyin, Chinese
          characters, tags, and common food uses.
        </p>
        <h3>Which herbs are best for beginners?</h3>
        <p>
          Goji berry, fresh ginger, jujube, chrysanthemum, black sesame, and lotus seed are
          among the easiest herbs to understand because they sit close to everyday food use.
        </p>
        <h3>Are all herbs here meant for beginners to try on their own?</h3>
        <p>
          No. Some pages are food-friendly and beginner-oriented, while others are included
          for educational depth and should be read more cautiously.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Suggested paths</p>
        <h2>Best places to start in the herb library</h2>
        <p>
          If you want kitchen-friendly herbs first, start with
          <a href="/herbs/goji-berry/">Goji Berry</a>,
          <a href="/herbs/fresh-ginger/">Fresh Ginger</a>,
          <a href="/herbs/jujube-red-date/">Jujube</a>, and
          <a href="/herbs/chrysanthemum-flower/">Chrysanthemum</a>.
        </p>
        <p>
          If you want to understand classic tonic herbs, compare
          <a href="/herbs/astragalus-root/">Astragalus Root</a>,
          <a href="/herbs/ginseng/">Ginseng</a>, and
          <a href="/herbs/codonopsis/">Codonopsis</a>.
        </p>
        <p>
          If you want softer pantry ingredients, a strong alternate route is
          <a href="/herbs/mulberry-fruit/">Mulberry Fruit</a>,
          <a href="/herbs/lotus-seed/">Lotus Seed</a>, and
          <a href="/herbs/tremella-mushroom/">Tremella Mushroom</a>.
        </p>
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Comparison guides</p>
        <h2>Best herb comparison pages for beginners</h2>
        <p>
          Some of the strongest educational pages on HerbGuide are simple side-by-side
          comparisons. They help readers understand how Chinese herb writing separates
          ingredients that sound similar at first glance.
        </p>
        <ul>
          <li><a href="/basics/fresh-ginger-vs-dried-ginger/">Fresh Ginger vs Dried Ginger</a></li>
          <li><a href="/basics/ginseng-vs-american-ginseng/">Ginseng vs American Ginseng</a></li>
          <li><a href="/basics/goji-berry-vs-jujube/">Goji Berry vs Jujube</a></li>
        </ul>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Learn by contrast</p>
        <h2>Why comparison pages matter</h2>
        <p>
          These guides teach readers that naming, preparation, nature, and kitchen role all
          matter in TCM herb education. That makes the full herb library easier to trust and
          easier to navigate.
        </p>
        <p>
          After these side-by-side pages, the best next step is <a href="/basics/">TCM Basics</a>
          for the broader vocabulary behind the comparisons.
        </p>
      </article>
    </div>
  </section>

  <script is:inline>
    const searchInput = document.querySelector("#herb-search");
    const herbCards = Array.from(document.querySelectorAll(".herb-card"));
    const emptyState = document.querySelector("#search-empty");
    const resultsCount = document.querySelector("#results-count");
    const categoryButtons = Array.from(document.querySelectorAll("[data-category-filter]"));
    const letterButtons = Array.from(document.querySelectorAll("[data-letter-filter]"));

    let activeCategory = "all";
    let activeLetter = "all";

    const renderResults = () => {
      const value = searchInput ? searchInput.value.trim().toLowerCase() : "";
      let visibleCount = 0;

      herbCards.forEach((card) => {
        const haystack = card.dataset.search ?? "";
        const matchesSearch = haystack.includes(value);
        const matchesCategory =
          activeCategory === "all" || (card.dataset.category ?? "") === activeCategory;
        const matchesLetter =
          activeLetter === "all" || (card.dataset.letter ?? "") === activeLetter;
        const isMatch = matchesSearch && matchesCategory && matchesLetter;

        card.style.display = isMatch ? "" : "none";

        if (isMatch) {
          visibleCount += 1;
        }
      });

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }

      if (resultsCount) {
        resultsCount.textContent =
          visibleCount === herbCards.length
            ? "Showing all herbs in the library."
            : `Showing ${visibleCount} herb${visibleCount === 1 ? "" : "s"} after filters.`;
      }
    };

    if (searchInput && herbCards.length > 0) {
      searchInput.addEventListener("input", () => {
        renderResults();
      });
    }

    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeCategory = button.dataset.categoryFilter ?? "all";
        categoryButtons.forEach((item) =>
          item.classList.toggle("is-active", item === button),
        );
        renderResults();
      });
    });

    letterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeLetter = button.dataset.letterFilter ?? "all";
        letterButtons.forEach((item) =>
          item.classList.toggle("is-active", item === button),
        );
        renderResults();
      });
    });
  </script>
</BaseLayout>
