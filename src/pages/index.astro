---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { basicsCards, classicsCards, goalCards, recipeCards } from "../data/content";
import { featuredHerbs, getHerbDisplayNames } from "../data/herbs";
import { topics } from "../data/topics";

const featuredTopicLinks = topics.slice(0, 4);
const featuredHerbLinks = featuredHerbs.slice(0, 4);
---

<BaseLayout
  title="Chinese Herbs, Food Therapy Recipes, and TCM Basics | HerbGuide"
  description="Explore Chinese herb profiles, food therapy recipes with ingredients and steps, plain-English TCM basics, and practical kitchen traditions."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "Chinese Herbs Explained in English",
      description:
        "A practical starting point for Chinese herb profiles, TCM basics, Chinese food traditions, and classical reading.",
      url: "https://herbguide.store/",
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is HerbGuide about?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "HerbGuide explains Traditional Chinese herbs, food traditions, and core TCM terms in clear American English for educational reading.",
          },
        },
        {
          "@type": "Question",
          name: "Does HerbGuide give personal health advice?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. HerbGuide is an educational site and does not provide diagnosis, treatment, or personal health advice.",
          },
        },
        {
          "@type": "Question",
          name: "What are the easiest Chinese herbs for beginners?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Goji berry, fresh ginger, jujube, chrysanthemum, and black sesame are among the easiest starting points because they connect naturally to tea, soup, and food traditions.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use this site to learn TCM terms in plain English?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. HerbGuide is built to explain pinyin names, channel entry, warming and cooling qualities, and other TCM terms in a more readable style.",
          },
        },
      ],
    },
  ]}
>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">Friendly and practical TCM learning</p>
        <h1>Traditional Chinese herbs, explained clearly for modern readers.</h1>
        <p class="hero-copy">
          Explore herb profiles, beginner-friendly TCM concepts, and practical Chinese food
          traditions written in clear American English.
        </p>
        <p class="hero-copy">
          Start with Chinese herb profiles, food therapy recipes with ingredients and steps,
          or plain-English TCM basics built for readers who want practical context without hype.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/herbs/">Start with the Herb Library</a>
          <a class="button button-secondary" href="/food-therapy/">Browse Food Therapy</a>
        </div>
      </div>
      <aside class="hero-card">
        <p class="eyebrow">Herb of the day</p>
        <h2>Goji Berry</h2>
        <p>
          A bright, beginner-friendly herb that bridges food, tradition, and everyday
          kitchen use without feeling intimidating.
        </p>
        <ul class="tag-list">
          <li>tea</li>
          <li>broths</li>
          <li>daily use</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro
        eyebrow="Start with familiar needs"
        title="Browse by everyday topic"
        text="We organize TCM content around recognizable themes so new readers have an easy starting point."
      />
      <div class="pill-grid">
        {goalCards.map((goal) => (
          <a class="pill-card" href={`/topics/${goal.slug}/`}>{goal.title}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro
        eyebrow="Topic hubs"
        title="Follow clearer reading paths"
        text="These curated topic hubs connect herbs, basics, and recipe-style pages so readers can explore by intent instead of jumping around blindly."
      />
      <div class="card-grid">
        {topics.slice(0, 3).map((topic) => (
          <article class="card">
            <p class="eyebrow">{topic.eyebrow}</p>
            <h3><a href={`/topics/${topic.slug}/`}>{topic.title}</a></h3>
            <p>{topic.description}</p>
            <p class="card-link">
              <a href={`/topics/${topic.slug}/`}>Open topic hub</a>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro
        eyebrow="Featured collection"
        title="Featured herbs"
        text="These are some of the easiest herbs to begin with because they are simpler to explain, easier to cook with, and easier to recognize in everyday kitchen use."
      />
      <div class="card-grid">
        {featuredHerbs.map((herb) => {
          const displayNames = getHerbDisplayNames(herb);

          return (
            <article class="card">
              <p class="eyebrow">{displayNames.secondary.slice(0, 2).join(" | ")}</p>
              <h3><a href={`/herbs/${herb.slug}/`}>{herb.name}</a></h3>
              <p>{herb.summary}</p>
              <p class="meta-label">TCM nature: {herb.nature}</p>
              <ul class="tag-list">
                {herb.foodUses.map((use) => (
                  <li>{use}</li>
                ))}
              </ul>
              <p class="card-link">
                <a href={`/herbs/${herb.slug}/`}>Read herb profile</a>
              </p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell two-up">
      <div>
        <SectionIntro
          eyebrow="Kitchen-first content"
          title="Food tradition picks"
          text="Simple soups, teas, pantry guides, and gentle routines keep the material practical instead of abstract."
        />
        <div class="stack">
          {recipeCards.map((card) => (
            <article class="list-card">
              <h3><a href={`/food-therapy/${card.slug}/`}>{card.title}</a></h3>
              <p>{card.text}</p>
              <p class="card-link"><a href={`/food-therapy/${card.slug}/`}>Read ingredients and steps</a></p>
            </article>
          ))}
        </div>
      </div>
      <div>
        <SectionIntro
          eyebrow="Plain-English learning"
          title="Learn TCM basics without the jargon wall"
          text="We keep foundational concepts simple, careful, and clearly separated from medical claims."
        />
        <div class="stack">
          {basicsCards.map((card) => (
            <article class="list-card">
              <h3><a href={`/basics/${card.slug}/`}>{card.title}</a></h3>
              <p>{card.text}</p>
              <p class="card-link"><a href={`/basics/${card.slug}/`}>Read article</a></p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Reader paths</p>
        <h2>Chinese herbs, TCM basics, and food therapy in one place</h2>
        <p>
          Most visitors arrive with mixed intent. Some want a single herb like goji berry or
          chrysanthemum. Others want Chinese food therapy recipes, beginner TCM terms, or
          practical kitchen guidance that feels easier to trust than generic wellness writing.
        </p>
        <p>
          HerbGuide is organized around those reading patterns so visitors can move from one
          clear answer into a deeper path instead of feeling stuck after one page.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Popular first clicks</p>
        <h2>Best pages for first-time visitors</h2>
        <ul>
          <li><a href="/food-therapy/a-simple-warming-soup-guide-for-cold-weather/">A Simple Warming Soup Guide for Cold Weather</a></li>
          <li><a href="/herbs/goji-berry/">Goji Berry</a></li>
          <li><a href="/food-therapy/jujube-and-ginger-tea-for-busy-weeks/">Jujube and Ginger Tea for Busy Weeks</a></li>
          <li><a href="/glossary/">TCM Glossary</a></li>
          <li><a href="/topics/warming-foods/">Warming Foods</a></li>
          <li><a href="/food-therapy/jobs-tears-porridge-for-heavy-days/">Job's Tears Porridge for Heavy Days</a></li>
          <li><a href="/food-therapy/goji-and-chrysanthemum-tea-basics/">Goji and Chrysanthemum Tea Basics</a></li>
          <li><a href="/food-therapy/tremella-and-pear-sweet-soup-basics/">Tremella and Pear Sweet Soup Basics</a></li>
          <li><a href="/food-therapy/chinese-yam-and-carrot-soup-basics/">Chinese Yam and Carrot Soup Basics</a></li>
        </ul>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Good next steps</p>
        <h2>Where visitors should go next</h2>
        <p>
          If a visitor starts with a recipe, send them to a herb page or a topic hub. If they
          start with a glossary page, send them to one practical kitchen article immediately.
          That is one of the simplest ways to turn a single useful page into a clearer
          learning path.
        </p>
        <p>
          One especially useful path is <a href="/glossary/">Glossary</a> to
          <a href="/topics/"> Topics</a> to
          <a href="/food-therapy/"> Food Therapy</a>.
        </p>
        <p>
          Two especially clear new paths are
          <a href="/basics/what-is-dampness/"> Dampness</a> to
          <a href="/food-therapy/jobs-tears-porridge-for-heavy-days/"> Job's Tears Porridge</a>
          and <a href="/basics/what-does-clear-heat-mean/">Clear Heat</a> to
          <a href="/food-therapy/pear-and-chrysanthemum-tea-for-warm-afternoons/"> Pear and Chrysanthemum Tea</a>.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Fast topic routes</p>
        <h2>Start with a topic hub when the reader has a broad goal</h2>
        <p>
          Topic hubs work especially well for homepage visitors who know the kind of help
          they want, but not the ingredient name yet. They often work better than sending
          every reader straight into isolated herb pages.
        </p>
        <ul>
          {featuredTopicLinks.map((topic) => (
            <li><a href={`/topics/${topic.slug}/`}>{topic.title}</a></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">If readers want comparisons</p>
        <h2>Best side-by-side pages to start with</h2>
        <ul>
          <li><a href="/basics/chrysanthemum-vs-mint/">Chrysanthemum vs Mint</a></li>
          <li><a href="/basics/goji-berry-tea-vs-goji-berry-porridge/">Goji Berry Tea vs Goji Berry Porridge</a></li>
          <li><a href="/basics/chen-pi-vs-hawthorn-berry/">Chen Pi vs Hawthorn Berry</a></li>
          <li><a href="/basics/poria-vs-jobs-tears/">Poria vs Job's Tears</a></li>
        </ul>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Intent-based starts</p>
        <h2>Choose a path that matches what the visitor wants</h2>
        <p>
          If the visitor wants cooling tea ideas, send them to
          <a href="/basics/chrysanthemum-vs-mint/"> Chrysanthemum vs Mint</a> and then
          <a href="/food-therapy/goji-and-chrysanthemum-tea-basics/"> Goji and Chrysanthemum Tea</a>.
        </p>
        <p>
          If they want nourishing pantry ideas, send them to
          <a href="/basics/goji-berry-tea-vs-goji-berry-porridge/"> Goji Berry Tea vs Goji Berry Porridge</a>
          and then <a href="/topics/balanced-pantry-habits/">Balanced Pantry Habits</a>.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Herb-first starts</p>
        <h2>Best herb pages to pair with broader guides</h2>
        <p>
          Readers who land on one searchable herb page should have a clear path into a topic
          hub, a basics explainer, or a kitchen article right away. These are some of the
          clearest homepage herb entries for that pattern.
        </p>
        <ul>
          {featuredHerbLinks.map((herb) => (
            <li><a href={`/herbs/${herb.slug}/`}>{herb.name}</a></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <div>
        <SectionIntro
          eyebrow="Cultural depth"
          title="Chinese classics worth knowing"
          text="This section opens with a grounded introduction to a few core books so readers understand where these ideas come from."
        />
        <div class="stack">
          {classicsCards.map((card) => (
            <article class="list-card">
              <h3><a href={`/classics/${card.slug}/`}>{card.title}</a></h3>
              <p>{card.text}</p>
              <p class="card-link"><a href={`/classics/${card.slug}/`}>Read article</a></p>
            </article>
          ))}
        </div>
      </div>
      <aside class="info-panel">
        <p class="eyebrow">Safety first</p>
        <h2>This site is for education, not personal health advice.</h2>
        <p>
          HerbGuide shares traditional context, research summaries, and food culture ideas.
          It does not provide diagnosis, treatment, or personal health advice.
        </p>
        <a class="button button-secondary" href="/safety/">Read the safety guide</a>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell newsletter-panel">
      <div>
        <p class="eyebrow">Stay connected</p>
        <h2>One practical herb note each week</h2>
        <p>
          A simple weekly note could share one herb, one kitchen use, one TCM term, and one
          caution note in an easy-to-read format.
        </p>
      </div>
      <div class="newsletter-note">
        <p>
          Email updates are coming later. For now, bookmark the Herb Library and Food
          Therapy sections to follow new herb profiles and practical kitchen content.
        </p>
        <a class="button button-primary" href="/herbs/">Browse current herb pages</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Reader questions</p>
        <h2>Chinese herb guide FAQ</h2>
        <h3>What are the easiest Chinese herbs for beginners?</h3>
        <p>
          Goji berry, fresh ginger, jujube, chrysanthemum, and black sesame are among the
          easiest starting points because they connect naturally to tea, soup, and food
          traditions.
        </p>
        <h3>Can I use this site to learn TCM terms in plain English?</h3>
        <p>
          Yes. HerbGuide is built to explain pinyin names, channel entry, warming and
          cooling qualities, and other TCM terms in a more readable style.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Best next clicks</p>
        <h2>Start with the most searchable pages</h2>
        <p>
          If you want popular herbs first, go to
          <a href="/herbs/goji-berry/"> Goji Berry</a>,
          <a href="/herbs/fresh-ginger/"> Fresh Ginger</a>, and
          <a href="/herbs/astragalus-root/"> Astragalus Root</a>.
        </p>
        <p>
          If you want supporting context, continue to
          <a href="/basics/"> TCM Basics</a>,
          <a href="/glossary/"> TCM Glossary</a>,
          <a href="/food-therapy/"> Food Therapy</a>, and
          <a href="/classics/"> Chinese Classics</a>.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
