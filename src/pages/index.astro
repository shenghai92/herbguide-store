---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { basicsCards, classicsCards, goalCards, recipeCards } from "../data/content";
import { featuredHerbs, getHerbDisplayNames } from "../data/herbs";
import { topics } from "../data/topics";

const featuredTopicLinks = topics.slice(0, 4);
const featuredHerbLinks = featuredHerbs.slice(0, 4);
---

<BaseLayout
  title="HerbGuide | Traditional Chinese Herbs & Kitchen Traditions in Plain English"
  description="Explore traditional Chinese herbs, kitchen recipes, and everyday pantry traditions in plain English, including goji berry porridge, jujube tea, chen pi tea, and beginner-friendly basics."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "Traditional Herbs Explained in English",
      description:
        "A practical starting point for herb guides, kitchen recipes, basics explainers, and traditional reading in plain English.",
      url: "https://herbguide.store/",
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is HerbGuide about?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "HerbGuide explains traditional herbs, food traditions, and core traditional terms in clear American English for educational reading.",
          },
        },
        {
          "@type": "Question",
          name: "Does HerbGuide give personal advice?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. HerbGuide is an educational site and does not provide personal advice, individualized recommendations, or one-to-one guidance.",
          },
        },
        {
          "@type": "Question",
          name: "What are the easiest herbs for beginners?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Goji berry, fresh ginger, jujube, chrysanthemum, and black sesame are among the easiest starting points because they connect naturally to tea, soup, and food traditions.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use this site to learn traditional terms in plain English?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. HerbGuide is built to explain pinyin names, channel entry, warming and cooling qualities, and other traditional terms in a more readable style.",
          },
        },
        {
          "@type": "Question",
          name: "Can I browse by herb guide, tea recipe, soup recipe, or ingredient topic?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. HerbGuide includes herb guides, tea recipes, soup recipes, pantry ingredient pages, and topic hubs so readers can browse by the kind of answer they want.",
          },
        },
      ],
    },
  ]}
>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">Herb guides in plain English</p>
        <h1>Herb guides, kitchen recipes, and traditional terms made easier to understand.</h1>
        <p class="hero-copy">
          Explore herb guides, kitchen recipes, ingredient comparisons, and beginner-friendly
          traditional concepts written in clear American English.
        </p>
        <p class="hero-copy">
          Start with familiar ingredients like goji berry, ginger, jujube, chrysanthemum,
          pear tea, jujube tea, chen pi tea, warming soups, or plain-English basics built for readers who want context without hype.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/herbs/">Start with the Herb Library</a>
          <a class="button button-secondary" href="/kitchen/">Browse Kitchen Traditions</a>
        </div>
      </div>
      <aside class="hero-card">
        <p class="eyebrow">Herb of the day</p>
        <h2>Goji Berry</h2>
        <p>
          A bright, beginner-friendly herb that bridges food, tradition, and everyday
          kitchen use without feeling intimidating.
        </p>
        <ul class="tag-list">
          <li>tea</li>
          <li>broths</li>
          <li>daily use</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell">
        <SectionIntro
          eyebrow="Start with familiar needs"
          title="Browse by everyday topic"
        text="We organize herb guides and kitchen pages around recognizable themes so new readers can start with digestive traditions, warming foods, pantry habits, or evening teas."
      />
      <div class="pill-grid">
        {goalCards.map((goal) => (
          <a class="pill-card" href={`/topics/${goal.slug}/`}>{goal.title}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro
        eyebrow="Topic guides"
        title="Follow clearer topic guides"
        text="These curated topic pages connect herbs, basics, and recipe-style pages so readers can explore by theme instead of jumping around blindly."
      />
      <div class="card-grid">
        {topics.slice(0, 3).map((topic) => (
          <article class="card">
            <p class="eyebrow">{topic.eyebrow}</p>
            <h3><a href={`/topics/${topic.slug}/`}>{topic.title}</a></h3>
            <p>{topic.description}</p>
            <p class="card-link">
              <a href={`/topics/${topic.slug}/`}>Open topic page</a>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro
        eyebrow="Featured collection"
        title="Featured herbs"
        text="These are some of the easiest herbs to begin with because they are simpler to explain, easier to cook with, and easier to recognize in everyday kitchen use."
      />
      <div class="card-grid">
        {featuredHerbs.map((herb) => {
          const displayNames = getHerbDisplayNames(herb);

          return (
            <article class="card">
              <p class="eyebrow">{displayNames.secondary.slice(0, 2).join(" | ")}</p>
              <h3><a href={`/herbs/${herb.slug}/`}>{herb.name}</a></h3>
              <p>{herb.summary}</p>
              <p class="meta-label">Traditional nature: {herb.nature}</p>
              <ul class="tag-list">
                {herb.foodUses.map((use) => (
                  <li>{use}</li>
                ))}
              </ul>
              <p class="card-link">
                <a href={`/herbs/${herb.slug}/`}>Read herb profile</a>
              </p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell two-up">
      <div>
        <SectionIntro
          eyebrow="Kitchen-first content"
          title="Food tradition picks"
          text="Simple soups, pear teas, pantry guides, and breakfast bowls keep the material concrete instead of abstract."
        />
        <div class="stack">
          {recipeCards.map((card) => (
            <article class="list-card">
              <h3><a href={`/kitchen/${card.slug}/`}>{card.title}</a></h3>
              <p>{card.text}</p>
              <p class="card-link"><a href={`/kitchen/${card.slug}/`}>Read ingredients and steps</a></p>
            </article>
          ))}
        </div>
      </div>
      <div>
        <SectionIntro
          eyebrow="Plain-English learning"
          title="Learn the basics without the jargon wall"
          text="We keep foundational concepts simple, careful, and clearly separated from exaggerated online claims."
        />
        <div class="stack">
          {basicsCards.map((card) => (
            <article class="list-card">
              <h3><a href={`/basics/${card.slug}/`}>{card.title}</a></h3>
              <p>{card.text}</p>
              <p class="card-link"><a href={`/basics/${card.slug}/`}>Read article</a></p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">How to explore</p>
        <h2>Herbs, basics, and kitchen traditions in one place</h2>
        <p>
          Some readers come here for one herb like goji berry or chrysanthemum. Others want
          kitchen recipes, beginner traditional terms, or practical kitchen guidance
          that feels easier to follow than generic lifestyle writing.
        </p>
        <p>
          HerbGuide brings those pieces together so readers can move from one clear answer
          into a broader understanding without feeling stuck after one page.
        </p>
        <p>
          Some readers want a herb guide. Others want a tea recipe, soup recipe, ingredient comparison,
          or plain-English term page. The homepage is designed to route all of those searches cleanly.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Good starting pages</p>
        <h2>Begin with familiar herbs and kitchen topics</h2>
        <ul>
          <li><a href="/kitchen/a-simple-warming-soup-guide-for-cold-weather/">A Simple Warming Soup Guide for Cold Weather</a></li>
          <li><a href="/herbs/goji-berry/">Goji Berry</a></li>
          <li><a href="/kitchen/jujube-and-ginger-tea-for-busy-weeks/">Jujube and Ginger Tea for Busy Weeks</a></li>
          <li><a href="/glossary/">Glossary</a></li>
          <li><a href="/topics/warming-foods/">Warming Foods</a></li>
          <li><a href="/kitchen/jobs-tears-porridge-for-heavy-days/">Job's Tears Porridge for Heavy Days</a></li>
          <li><a href="/kitchen/goji-and-chrysanthemum-tea-basics/">Goji and Chrysanthemum Tea Basics</a></li>
          <li><a href="/kitchen/tremella-and-pear-sweet-soup-basics/">Tremella and Pear Sweet Soup Basics</a></li>
          <li><a href="/kitchen/chinese-yam-and-carrot-soup-basics/">Chinese Yam and Carrot Soup Basics</a></li>
        </ul>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Natural follow-ups</p>
        <h2>Move from one page into related reading</h2>
        <p>
          A recipe often pairs well with a herb page or a topic page. A glossary page often
          makes more sense after one practical kitchen article. Reading across these formats
          makes the traditional language easier to understand.
        </p>
        <p>
          One especially useful path is <a href="/glossary/">Glossary</a> to
          <a href="/topics/"> Topics</a> to
          <a href="/kitchen/"> Kitchen Traditions</a>.
        </p>
        <p>
          Two especially clear new paths are
          <a href="/basics/what-is-dampness/"> Dampness</a> to
          <a href="/kitchen/jobs-tears-porridge-for-heavy-days/"> Job's Tears Porridge</a>
          and <a href="/basics/what-does-clear-heat-mean/">Clear Heat</a> to
          <a href="/kitchen/pear-and-chrysanthemum-tea-for-warm-afternoons/"> Pear and Chrysanthemum Tea</a>.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Topic pages</p>
        <h2>Start with a theme when you do not know the ingredient name yet</h2>
        <p>
          Topic pages work well when a reader knows the kind of kitchen or seasonal question
          they have, but not the ingredient name yet. They bring herb pages, basics explainers,
          and food articles into one place.
        </p>
        <ul>
          {featuredTopicLinks.map((topic) => (
            <li><a href={`/topics/${topic.slug}/`}>{topic.title}</a></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Compare similar ingredients</p>
        <h2>Side-by-side pages for clearer distinctions</h2>
        <ul>
          <li><a href="/basics/chrysanthemum-vs-mint/">Chrysanthemum vs Mint</a></li>
          <li><a href="/basics/goji-berry-tea-vs-goji-berry-porridge/">Goji Berry Tea vs Goji Berry Porridge</a></li>
          <li><a href="/basics/chen-pi-vs-hawthorn-berry/">Chen Pi vs Hawthorn Berry</a></li>
          <li><a href="/basics/poria-vs-jobs-tears/">Poria vs Job's Tears</a></li>
        </ul>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Try these pairings</p>
        <h2>Useful combinations of basics and kitchen pages</h2>
        <p>
          For cooling tea ideas, start with
          <a href="/basics/chrysanthemum-vs-mint/"> Chrysanthemum vs Mint</a> and then
          <a href="/kitchen/goji-and-chrysanthemum-tea-basics/"> Goji and Chrysanthemum Tea</a>.
        </p>
        <p>
          For nourishing pantry ideas, continue to
          <a href="/basics/goji-berry-tea-vs-goji-berry-porridge/"> Goji Berry Tea vs Goji Berry Porridge</a>
          and then <a href="/topics/balanced-pantry-habits/">Balanced Pantry Habits</a>.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Herb-first reading</p>
        <h2>Start with a familiar herb, then branch outward</h2>
        <p>
          A familiar herb page often becomes easier to understand when it is paired with a
          topic page, a basics explainer, or a kitchen article. These are some of the clearest
          starting points on the homepage.
        </p>
        <ul>
          {featuredHerbLinks.map((herb) => (
            <li><a href={`/herbs/${herb.slug}/`}>{herb.name}</a></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <div>
        <SectionIntro
          eyebrow="Cultural depth"
          title="Classics worth knowing"
          text="This section opens with a grounded introduction to a few core books so readers understand where these ideas come from."
        />
        <div class="stack">
          {classicsCards.map((card) => (
            <article class="list-card">
              <h3><a href={`/classics/${card.slug}/`}>{card.title}</a></h3>
              <p>{card.text}</p>
              <p class="card-link"><a href={`/classics/${card.slug}/`}>Read article</a></p>
            </article>
          ))}
        </div>
      </div>
      <aside class="info-panel">
        <p class="eyebrow">Safety first</p>
        <h2>This site is for education, not individualized advice.</h2>
        <p>
          HerbGuide shares traditional context, research summaries, and food culture ideas.
          It does not provide personal advice, individualized recommendations, or one-to-one guidance.
        </p>
        <a class="button button-secondary" href="/safety/">Read the safety guide</a>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell newsletter-panel">
      <div>
        <p class="eyebrow">Keep exploring</p>
        <h2>New herb pages and kitchen guides are added over time</h2>
        <p>
          The library continues to expand with practical herb profiles, kitchen examples,
          traditional vocabulary, and clear safety notes.
        </p>
      </div>
      <div class="newsletter-note">
        <p>
          For now, the easiest way to keep reading is to browse the Herb Library and Kitchen
          Traditions sections and follow the links between related pages.
        </p>
        <a class="button button-primary" href="/herbs/">Browse current herb pages</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Reader questions</p>
        <h2>Herb guide FAQ</h2>
        <h3>What are the easiest herbs for beginners?</h3>
        <p>
          Goji berry, fresh ginger, jujube, chrysanthemum, and black sesame are among the
          easiest starting points because they connect naturally to tea, soup, and food
          traditions.
        </p>
        <h3>Can I use this site to learn traditional terms in plain English?</h3>
        <p>
          Yes. HerbGuide is built to explain pinyin names, channel entry, warming and
          cooling qualities, and other traditional terms in a more readable style.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Start here</p>
        <h2>Popular herb pages and supporting guides</h2>
        <p>
          For popular herbs first, go to
          <a href="/herbs/goji-berry/"> Goji Berry</a>,
          <a href="/herbs/fresh-ginger/"> Fresh Ginger</a>, and
          <a href="/herbs/astragalus-root/"> Astragalus Root</a>.
        </p>
        <p>
          For supporting context, continue to
          <a href="/basics/"> Basics</a>,
          <a href="/glossary/"> Glossary</a>,
          <a href="/kitchen/"> Kitchen Traditions</a>, and
          <a href="/classics/"> Chinese Classics</a>.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
