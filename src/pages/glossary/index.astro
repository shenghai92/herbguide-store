---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import { basicsArticles } from "../../data/articles";
---

<BaseLayout
  title="TCM Glossary | HerbGuide"
  description="A plain-English glossary of core Traditional Chinese Medicine terms used across HerbGuide."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "TCM Glossary",
      description: "A plain-English glossary of core Traditional Chinese Medicine terms used across HerbGuide.",
      url: "https://herbguide.store/glossary/",
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What are the most important TCM terms for beginners?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Qi, dampness, warming and cooling, yin and yang, blood, spleen, liver, and channel entry are among the most useful beginner terms because they appear repeatedly across herb and food pages.",
          },
        },
        {
          "@type": "Question",
          name: "Is the HerbGuide glossary for diagnosis?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. The glossary is for plain-English educational reading and helps readers understand traditional Chinese medicine vocabulary without turning terms into self-diagnosis.",
          },
        },
        {
          "@type": "Question",
          name: "Should I read glossary pages or herb pages first?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Either path can work, but many beginners learn faster by reading one glossary page and then opening a related herb or food therapy page right away.",
          },
        },
      ],
    },
  ]}
>
  <section class="page-hero">
    <div class="shell narrow">
      <p class="eyebrow">TCM Glossary</p>
      <h1>Core TCM terms in plain English</h1>
      <p>
        This glossary collects the core Traditional Chinese Medicine ideas that readers see
        repeatedly across herb pages, recipe articles, and topic hubs.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro
        eyebrow="Glossary paths"
        title="Start with the terms people actually search"
        text="These pages are designed to answer direct beginner questions clearly, without drifting into hype or confusing jargon."
      />
      <div class="card-grid">
        {basicsArticles.map((article) => (
          <article class="card">
            <p class="eyebrow">{article.eyebrow}</p>
            <h2><a href={`/basics/${article.slug}/`}>{article.title}</a></h2>
            <p>{article.description}</p>
            <p class="card-link"><a href={`/basics/${article.slug}/`}>Read term guide</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Best glossary starts</p>
        <h2>Highest-value term pages for beginners</h2>
        <ul>
          <li><a href="/basics/what-does-qi-mean/">What Does Qi Mean?</a></li>
          <li><a href="/basics/what-is-dampness/">What Is Dampness?</a></li>
          <li><a href="/basics/what-does-spleen-mean-in-tcm/">What Does Spleen Mean in TCM?</a></li>
          <li><a href="/basics/what-does-clear-heat-mean/">What Does Clear Heat Mean?</a></li>
          <li><a href="/basics/what-does-tonify-mean-in-tcm/">What Does Tonify Mean in TCM?</a></li>
          <li><a href="/basics/what-does-channel-entry-mean/">What Does Channel Entry Mean?</a></li>
          <li><a href="/basics/what-is-food-stagnation-in-tcm/">What Is Food Stagnation in TCM?</a></li>
        </ul>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Why glossary pages matter</p>
        <h2>Short questions often lead to the best entry pages</h2>
        <p>
          Searches like what is qi, what does dampness mean, what is yin and yang, or fresh
          ginger vs dried ginger are often the first touchpoint for new readers. A strong
          glossary layer helps HerbGuide meet those readers early.
        </p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Keep exploring</p>
        <h2>Use the glossary with topic hubs</h2>
        <p>
          After learning one term, the best next step is usually a <a href="/topics/">Topic Hub</a>
          or a concrete ingredient page in the <a href="/herbs/">Herb Library</a>.
        </p>
        <p>
          Strong current pairings are <a href="/basics/what-is-dampness/">dampness</a> to
          <a href="/food-therapy/jobs-tears-porridge-for-heavy-days/"> Job's Tears Porridge</a>
          and <a href="/basics/what-does-clear-heat-mean/">clear heat</a> to
          <a href="/food-therapy/pear-and-chrysanthemum-tea-for-warm-afternoons/"> Pear and Chrysanthemum Tea</a>.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
