---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../data/site";
---

<BaseLayout
  title="Support HerbGuide | HerbGuide"
  description="Optional reader support for HerbGuide. All content stays free, and support simply helps fund more kitchen guides and herb pages."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: "Support HerbGuide",
      description:
        "Optional reader support for HerbGuide. All content stays free, and support simply helps fund more kitchen guides and herb pages.",
      url: "https://herbguide.store/support/",
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is HerbGuide free to use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. All HerbGuide pages and site features are currently free to every reader.",
          },
        },
        {
          "@type": "Question",
          name: "Does support unlock extra content?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Optional support does not unlock premium content, extra tools, or special access.",
          },
        },
        {
          "@type": "Question",
          name: "Who processes payment for support links?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Support payments are processed through Creem on their own checkout pages rather than directly on HerbGuide.",
          },
        },
      ],
    },
  ]}
>
  <section class="page-hero">
    <div class="shell narrow prose-block">
      <p class="eyebrow">Optional support</p>
      <h1>Support HerbGuide without changing access</h1>
      <p>
        HerbGuide keeps all site content and all core site features free. Optional reader support
        simply helps fund more herb pages, kitchen guides, and plain-English educational content.
      </p>
      <p>
        Support is voluntary. It does not unlock the herb library, kitchen pages, extra tools,
        downloads, or special access.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Support options</p>
        <h2>Choose a simple support amount</h2>
        <p>
          These links are for readers who want to support the work behind HerbGuide. Both options
          are one-time support purchases processed on Creem checkout pages.
        </p>
        <div class="hero-actions">
          <a
            class="button button-secondary"
            href={siteConfig.supportLinks.small}
            data-support-tier="small_support"
            data-support-value="4.90"
            rel="nofollow sponsored external"
            target="_blank"
          >
            $4.90 support
          </a>
          <a
            class="button button-primary"
            href={siteConfig.supportLinks.large}
            data-support-tier="large_support"
            data-support-value="9.90"
            rel="nofollow sponsored external"
            target="_blank"
          >
            $9.90 support
          </a>
        </div>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">What support does</p>
        <h2>What reader support helps fund</h2>
        <ul>
          <li>More herb pages with cleaner internal links and stronger beginner explanations.</li>
          <li>More kitchen guides, recipe pages, and pantry-focused educational content.</li>
          <li>More time spent improving search, page structure, and overall site usability.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-up">
      <article class="prose-block card">
        <p class="eyebrow">Support FAQ</p>
        <h2>Common questions</h2>
        <h3>Is HerbGuide free to use?</h3>
        <p>Yes. All current content and site features remain free to every reader.</p>
        <h3>Does support unlock extra content?</h3>
        <p>No. Support is optional and does not unlock premium content, private pages, or extra tools.</p>
        <h3>Who processes payment?</h3>
        <p>Support payments are handled by Creem on external checkout pages, not inside HerbGuide itself.</p>
      </article>

      <article class="prose-block card">
        <p class="eyebrow">Helpful links</p>
        <h2>Related trust pages</h2>
        <ul>
          <li><a href="/about/">About HerbGuide</a></li>
          <li><a href="/disclaimer/">Disclaimer</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/editorial-policy/">Editorial Policy</a></li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
