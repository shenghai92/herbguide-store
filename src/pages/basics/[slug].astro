---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { basicsArticles } from "../../data/articles";
import { getTopicsForBasics } from "../../data/topics";

export function getStaticPaths() {
  return basicsArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const relatedTopics = getTopicsForBasics(article.slug);
const basicsSeoMap: Record<
  string,
  {
    title: string;
    description: string;
    extraKeywords: string[];
    heroNote?: string;
  }
> = {
  "chen-pi-tea-recipe-faq": {
    title: "Chen Pi Tea Recipe FAQ | HerbGuide",
    description:
      "A plain-English FAQ answering how to make chen pi tea, what ingredients are used, and how long a simple chen pi tea recipe should simmer.",
    extraKeywords: [
      "chen pi tea recipe faq",
      "how to make chen pi tea",
      "chen pi tea recipe",
      "what is in chen pi tea",
      "how long to simmer chen pi tea",
    ],
    heroNote:
      "This page is built around the question-style search intent readers use when they want a direct, low-hype chen pi tea answer.",
  },
  "warming-vs-cooling-foods": {
    title: "Warming vs Cooling Foods Meaning in Plain English | HerbGuide",
    description:
      "A plain-English guide to warming vs cooling foods with simple examples from tea, soup, pear recipes, ginger pages, seasonal kitchen reading, and pantry-friendly ingredient contrasts.",
    extraKeywords: ["warming vs cooling foods", "warming foods", "cooling foods", "warming and cooling foods meaning", "warming foods vs cooling foods", "traditional food properties"],
    heroNote:
      "Readers often search this page because they want the meaning of warming foods and cooling foods in plain English before they open more specific herb or kitchen pages.",
  },
  "fresh-ginger-vs-dried-ginger": {
    title: "Fresh Ginger vs Dried Ginger Meaning in Plain English | HerbGuide",
    description:
      "A plain-English guide to fresh ginger vs dried ginger with kitchen examples, warming differences, and why traditional pages keep them separate.",
    extraKeywords: ["fresh ginger vs dried ginger", "fresh ginger vs dried ginger meaning", "sheng jiang vs gan jiang", "fresh ginger compared with dried ginger"],
    heroNote:
      "Readers usually land here because they want a direct explanation of why fresh ginger and dried ginger are treated differently in traditional kitchen writing.",
  },
  "what-are-the-five-flavors": {
    title: "What Are the Five Flavors? Meaning in Plain English | HerbGuide",
    description:
      "A plain-English guide to the five flavors in traditional Chinese food writing, with simple kitchen examples and balance ideas.",
    extraKeywords: ["what are the five flavors", "five flavors meaning", "five flavors in Chinese cooking", "wu wei meaning", "traditional Chinese five flavors"],
    heroNote:
      "Readers often search this topic because they want one clear explanation of how sour, bitter, sweet, pungent, and salty work together in traditional kitchen language.",
  },
  "chinese-pantry-starter-kit": {
    title: "The Chinese Pantry Starter Kit | HerbGuide",
    description:
      "A friendly, opinionated list of 10 traditional ingredients every curious cook should know. This page bridges the gap between a daunting Asian grocery store and your home kitchen.",
    extraKeywords: ["chinese pantry starter kit", "chinese pantry staples", "traditional chinese ingredients", "asian grocery shopping guide", "chinese cooking pantry"],
    heroNote:
      "Readers often land here because they want a practical list of traditional Chinese pantry ingredients they can actually find and use in everyday cooking.",
  },
  "simple-herbal-tea-routine": {
    title: "How to Build a Simple Herbal Tea Routine | HerbGuide",
    description:
      "Practical, seasonal, no-pressure guidance for people who want a traditional tea ritual, not a strict medical regimen.",
    extraKeywords: ["herbal tea routine", "chinese tea ritual", "how to make herbal tea", "traditional tea routine", "simple tea ritual"],
    heroNote:
      "Readers often search this topic because they want a simple, no-pressure way to incorporate traditional tea habits into their daily life.",
  },
  "what-is-wind-heat": {
    title: "What Is Wind-Heat? Meaning in Plain English | HerbGuide",
    description:
      "A plain-English guide to Wind-Heat — what it means, key signs, causes, traditional approaches, and practical cooling kitchen notes for beginners learning about seasonal wellness.",
    extraKeywords: ["what is wind heat", "wind heat meaning", "wind heat symptoms", "wind heat vs wind cold", "traditional wind heat explanation", "cooling herbs for wind heat"],
    heroNote:
      "Readers often search this term because they want a clear, plain-English explanation of Wind-Heat and how it differs from Wind-Cold in traditional herb descriptions.",
  },
  "what-is-liver-blood-deficiency": {
    title: "What Is Liver Blood Deficiency? Meaning in Plain English | HerbGuide",
    description:
      "A plain-English guide to Liver Blood Deficiency — what it means, key signs, causes, traditional approaches to nourishing Liver Blood, and practical lifestyle and kitchen notes.",
    extraKeywords: ["what is liver blood deficiency", "liver blood deficiency meaning", "liver blood deficiency symptoms", "traditional liver blood deficiency", "nourish liver blood", "liver blood deficiency vs liver qi stagnation"],
    heroNote:
      "Readers often search this term because they want a clear, plain-English explanation of Liver Blood Deficiency and how it connects to eye health, sleep, and women's wellness in traditional herb descriptions.",
  },
  "what-is-stomach-yin-deficiency": {
    title: "What Is Stomach Yin Deficiency? Meaning in Plain English | HerbGuide",
    description:
      "A plain-English guide to Stomach Yin Deficiency — what it means, key signs, causes, traditional approaches to nourishing Stomach Yin, and practical lifestyle and kitchen notes.",
    extraKeywords: ["what is stomach yin deficiency", "stomach yin deficiency meaning", "stomach yin deficiency symptoms", "traditional stomach yin deficiency", "nourish stomach yin", "stomach yin deficiency diet"],
    heroNote:
      "Readers often search this term because they want a clear, plain-English explanation of Stomach Yin Deficiency and how it relates to digestive dryness, hydration, and diet in traditional herb descriptions.",
  },
  "what-is-lung-yin-deficiency": {
    title: "What Is Lung Yin Deficiency? Meaning in Plain English | HerbGuide",
    description:
      "A plain-English guide to Lung Yin Deficiency — what it means, key signs, causes, traditional approaches to nourishing Lung Yin, and practical lifestyle and kitchen notes.",
    extraKeywords: ["what is lung yin deficiency", "lung yin deficiency meaning", "lung yin deficiency symptoms", "traditional lung yin deficiency", "nourish lung yin", "lung yin deficiency dry cough", "lung yin deficiency diet"],
    heroNote:
      "Readers often search this term because they want a clear, plain-English explanation of Lung Yin Deficiency and how it relates to dry cough, throat health, and respiratory moisture in traditional herb descriptions.",
  },
  "what-is-kidney-yang-deficiency": {
    title: "What Is Kidney Yang Deficiency? Meaning in Plain English | HerbGuide",
    description:
      "A plain-English guide to Kidney Yang Deficiency — what it means, key signs, causes, traditional approaches to warming Kidney Yang, and practical lifestyle and kitchen notes.",
    extraKeywords: ["what is kidney yang deficiency", "kidney yang deficiency meaning", "kidney yang deficiency symptoms", "traditional kidney yang deficiency", "warm kidney yang", "kidney yang deficiency cold", "kidney yang deficiency diet"],
    heroNote:
      "Readers often search this term because they want a clear, plain-English explanation of Kidney Yang Deficiency and how it relates to deep coldness, lower back weakness, and warming foods in traditional herb descriptions.",
  },
  "what-is-liver-qi-stagnation": {
    title: "What Is Liver Qi Stagnation? Meaning in Plain English | HerbGuide",
    description:
      "A plain-English guide to Liver Qi Stagnation — what it means, key signs, causes, traditional approaches to smoothing Liver Qi, and practical lifestyle and kitchen notes.",
    extraKeywords: ["what is liver qi stagnation", "liver qi stagnation meaning", "liver qi stagnation symptoms", "traditional liver qi stagnation", "soothe liver qi", "liver qi stagnation diet", "liver qi stagnation stress"],
    heroNote:
      "Readers often search this term because they want a clear, plain-English explanation of Liver Qi Stagnation and how it relates to stress, emotional tension, and digestion in traditional herb descriptions.",
  },
  "what-is-heart-yin-deficiency": {
    title: "What Is Heart Yin Deficiency? Meaning in Plain English | HerbGuide",
    description:
      "A plain-English guide to Heart Yin Deficiency — what it means, key signs, causes, traditional approaches to nourishing Heart Yin and calming the Shen, and practical lifestyle and kitchen notes.",
    extraKeywords: ["what is heart yin deficiency", "heart yin deficiency meaning", "heart yin deficiency symptoms", "traditional heart yin deficiency", "nourish heart yin", "heart yin deficiency sleep", "heart yin deficiency diet"],
    heroNote:
      "Readers often search this term because they want a clear, plain-English explanation of Heart Yin Deficiency and how it relates to insomnia, anxiety, and palpitations in traditional herb descriptions.",
  },
  "what-is-lung-qi-deficiency": {
    title: "What Is Lung Qi Deficiency? Meaning in Plain English | HerbGuide",
    description:
      "A plain-English guide to Lung Qi Deficiency — what it means, key signs, causes, traditional approaches to tonifying Lung Qi, and practical lifestyle and kitchen notes.",
    extraKeywords: ["what is lung qi deficiency", "lung qi deficiency meaning", "lung qi deficiency symptoms", "traditional lung qi deficiency", "tonify lung qi", "lung qi deficiency immune", "lung qi deficiency diet"],
    heroNote:
      "Readers often search this term because they want a clear, plain-English explanation of Lung Qi Deficiency and how it relates to weak immunity, shortness of breath, and frequent colds in traditional herb descriptions.",
  },
  "what-is-kidney-yin-deficiency": {
    title: "What Is Kidney Yin Deficiency? Meaning in Plain English | HerbGuide",
    description:
      "A plain-English guide to Kidney Yin Deficiency — what it means, key signs, causes, traditional approaches to nourishing Kidney Yin, and practical lifestyle and kitchen notes.",
    extraKeywords: ["what is kidney yin deficiency", "kidney yin deficiency meaning", "kidney yin deficiency symptoms", "traditional kidney yin deficiency", "nourish kidney yin", "kidney yin deficiency heat", "kidney yin deficiency diet"],
    heroNote:
      "Readers often search this term because they want a clear, plain-English explanation of Kidney Yin Deficiency and how it relates to night sweats, dryness, and lower back weakness in traditional herb descriptions.",
  },
};
const basicsSeo = basicsSeoMap[article.slug];
const articleKeywords = [
  article.title,
  `${article.title} meaning`,
  `${article.title} plain English`,
  `what does ${article.title.replace(/\?$/, "")} mean`,
  "traditional terms",
  "plain English guide",
  ...(basicsSeo?.extraKeywords ?? []),
];
const basicsFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity:
    article.slug === "chen-pi-tea-recipe-faq"
      ? [
          {
            "@type": "Question",
            name: "How do you make chen pi tea?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "A simple version uses 1 to 2 small pieces of chen pi, water, and a short gentle simmer of about 10 minutes before straining.",
            },
          },
          {
            "@type": "Question",
            name: "What ingredients are used in a simple chen pi tea recipe?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Most simple versions use chen pi and water, with optional ginger or a small piece of hawthorn for variation.",
            },
          },
          {
            "@type": "Question",
            name: "How long should chen pi tea simmer?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Around 10 minutes is usually enough for a light, aromatic cup.",
            },
          },
          {
            "@type": "Question",
            name: "Is chen pi tea usually made with ginger or on its own?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Both styles appear in kitchen writing, but a plain chen pi version is often the easiest starting point for beginners.",
            },
          },
        ]
      : article.slug === "warming-vs-cooling-foods"
        ? [
            {
              "@type": "Question",
              name: "What do warming and cooling foods mean in plain English?",
              acceptedAnswer: {
                "@type": "Answer",
                text: "They are traditional food labels that describe how an ingredient is categorized in historical herb and kitchen writing, not the serving temperature of the dish.",
              },
            },
            {
              "@type": "Question",
              name: "Is a cooling food always served cold?",
              acceptedAnswer: {
                "@type": "Answer",
                text: "No. A cooling tea can still be served hot, and a warming ingredient can appear in room-temperature dishes. The label is about traditional classification.",
              },
            },
            {
              "@type": "Question",
              name: "What are simple warming food examples?",
              acceptedAnswer: {
                "@type": "Answer",
                text: "Fresh ginger and some warming soup pages are among the clearest beginner examples on HerbGuide.",
              },
            },
            {
              "@type": "Question",
              name: "What are simple cooling food examples?",
              acceptedAnswer: {
                "@type": "Answer",
                text: "Chrysanthemum, mint, pear tea, and other lighter seasonal pages are among the clearest cooling examples on HerbGuide.",
              },
            },
          ]
      : [
          {
            "@type": "Question",
            name: `What does ${article.title.replace(/\?$/, "")} mean in plain English?`,
            acceptedAnswer: {
              "@type": "Answer",
              text: `${article.title} is explained here in plain English as part of traditional herb and food writing, with clear boundaries and beginner-friendly context.`,
            },
          },
          {
            "@type": "Question",
            name: `Is ${article.title.replace(/\?$/, "")} a personal label or direct self-check?`,
            acceptedAnswer: {
              "@type": "Answer",
              text: `No. HerbGuide presents ${article.title} as traditional vocabulary for educational reading, not as a personal label, direct self-check, or one-to-one guidance.`,
            },
          },
        ],
};
---

<BaseLayout
  title={basicsSeo?.title ?? `${article.title} Meaning in Plain English | HerbGuide`}
  description={basicsSeo?.description ?? `${article.description} Learn the term in plain English with examples from herb and kitchen pages.`}
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: article.title,
      description: article.description,
      url: `https://herbguide.store/basics/${article.slug}/`,
      keywords: articleKeywords.join(", "),
      author: {
        "@type": "Organization",
        name: "HerbGuide",
      },
      publisher: {
        "@type": "Organization",
        name: "HerbGuide",
      },
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://herbguide.store/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Basics",
          item: "https://herbguide.store/basics/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: article.title,
          item: `https://herbguide.store/basics/${article.slug}/`,
        },
      ],
    },
    basicsFaqSchema,
  ]}
>
  <section class="page-hero">
    <div class="shell narrow prose-block">
      <p class="eyebrow">{article.eyebrow}</p>
      <h1>{article.title}</h1>
      <p>{article.intro}</p>
      {basicsSeo?.heroNote && <p>{basicsSeo.heroNote}</p>}
      <p>
        This page is written for readers who want the meaning in plain English before moving
        into herb guides, ingredient comparisons, or kitchen pages.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell narrow stack">
      {article.sections.map((section) => (
        <article class="prose-block card">
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
        </article>
      ))}
      <article class="prose-block card">
        <p class="eyebrow">Suggested herb pages</p>
        <h2>Use these articles with the herb library</h2>
        <p>
          The easiest next step is to compare this article with practical herb examples in the
          <a href="/herbs/"> Herb Library</a>.
        </p>
        <ul>
          {article.slug === "chen-pi-tea-recipe-faq" ? (
            <>
              <li><a href="/herbs/chen-pi/">Chen Pi</a> for the ingredient profile behind the tea</li>
              <li><a href="/herbs/fresh-ginger/">Fresh Ginger</a> for the most common optional add-in</li>
              <li><a href="/kitchen/chen-pi-tea-for-heavy-meal-days/">Chen Pi Tea for Heavy Meal Days</a> for a recipe-style version</li>
              <li><a href="/basics/chen-pi-vs-hawthorn-berry/">Chen Pi vs Hawthorn Berry</a> for a related digestive pantry comparison</li>
            </>
          ) : article.slug === "what-are-the-five-flavors" ? (
            <>
              <li><a href="/herbs/hawthorn-berry/">Hawthorn Berry</a> for a clear sour example</li>
              <li><a href="/herbs/fresh-ginger/">Fresh Ginger</a> for a clear pungent example</li>
              <li><a href="/herbs/jujube-red-date/">Jujube</a> for a mild sweet pantry example</li>
              <li><a href="/basics/fresh-ginger-vs-dried-ginger/">Fresh Ginger vs Dried Ginger</a> for a flavor-and-function comparison</li>
            </>
          ) : (
            <>
              <li><a href="/herbs/astragalus-root/">Astragalus Root</a> for qi-related vocabulary</li>
              <li><a href="/herbs/fresh-ginger/">Fresh Ginger</a> for warming kitchen language</li>
              <li><a href="/herbs/chrysanthemum-flower/">Chrysanthemum</a> for cooling language</li>
              <li><a href="/herbs/poria/">Poria</a> for dampness-related reading</li>
            </>
          )}
          {article.slug === "warming-vs-cooling-foods" && (
            <>
              <li><a href="/kitchen/jujube-and-ginger-tea-for-busy-weeks/">Jujube and Ginger Tea</a> for a warming tea example</li>
              <li><a href="/kitchen/pear-and-chrysanthemum-tea-for-warm-afternoons/">Pear and Chrysanthemum Tea</a> for a cooling tea example</li>
              <li><a href="/herbs/mint/">Mint</a> for a clearer cooling herb comparison</li>
              <li><a href="/herbs/cinnamon-twig/">Cinnamon Twig</a> for a stronger warming herb example</li>
            </>
          )}
        </ul>
      </article>
      <article class="prose-block card">
        <p class="eyebrow">Keep exploring</p>
        <h2>Back to Basics</h2>
        <p>
          This article is part of the <a href="/basics/">Basics</a> section. Continue there
          for more plain-English explanations of traditional herb terms.
        </p>
      </article>
      <article class="prose-block card">
        <p class="eyebrow">Basics FAQ</p>
        <h2>Common questions about this term</h2>
        {article.slug === "chen-pi-tea-recipe-faq" ? (
          <>
            <h3>How do you make chen pi tea?</h3>
            <p>
              A simple version uses 1 to 2 small pieces of chen pi, water, and a short simmer
              of about 10 minutes before straining into cups.
            </p>
            <h3>What ingredients are used in a simple chen pi tea recipe?</h3>
            <p>
              Most versions stay very simple: chen pi and water, with optional ginger or a
              small piece of hawthorn for variation.
            </p>
            <h3>How long should chen pi tea simmer?</h3>
            <p>
              Around 10 minutes is usually enough for a light, aromatic cup that still tastes
              clean and clear.
            </p>
            <h3>Is chen pi tea usually made with ginger or on its own?</h3>
            <p>
              Both versions are common, but the plain version is often the easiest starting
              point when readers want to understand chen pi itself.
            </p>
          </>
        ) : article.slug === "warming-vs-cooling-foods" ? (
          <>
            <h3>What do warming and cooling foods mean in plain English?</h3>
            <p>
              They are traditional food labels that describe how ingredients are categorized in
              historical herb and kitchen writing, not the serving temperature of the dish.
            </p>
            <h3>Is a cooling food always served cold?</h3>
            <p>
              No. A cooling tea can still be served hot, and a warming ingredient can appear in
              room-temperature dishes. The label is about traditional classification.
            </p>
            <h3>What are simple warming food examples?</h3>
            <p>
              Fresh ginger, warming soups, and ginger-based tea pages are some of the clearest
              beginner examples on HerbGuide.
            </p>
            <h3>What are simple cooling food examples?</h3>
            <p>
              Chrysanthemum, mint, pear tea, and other lighter seasonal pages are some of the
              clearest cooling examples on HerbGuide.
            </p>
          </>
        ) : (
          <>
            <h3>What does this term mean in plain English?</h3>
            <p>
              This page explains the term in plain English as part of traditional herb and food
              writing, with beginner-friendly context and clearer wording.
            </p>
            <h3>Is this a personal label or direct self-check?</h3>
            <p>
              No. HerbGuide presents this term as traditional vocabulary for educational reading,
              not as a personal label, direct self-check, or one-to-one guidance.
            </p>
          </>
        )}
      </article>
      {relatedTopics.length > 0 && (
        <article class="prose-block card">
          <p class="eyebrow">Topic hubs</p>
          <h2>Browse this idea by theme</h2>
          <ul>
            {relatedTopics.map((topic) => (
              <li><a href={`/topics/${topic.slug}/`}>{topic.title}</a></li>
            ))}
          </ul>
        </article>
      )}
    </div>
  </section>
</BaseLayout>
